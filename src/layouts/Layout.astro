---
import '../styles/global.css'

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Cyber Tour Réunion 2026 - 3 étapes, 20-23 Octobre 2026. Organisé par le CLUSIR Réunion Océan Indien." } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f1a30" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    {/*
      Préchargement des fontes — seulement les fontes du premier rendu.
      Toutes les fontes du site sont en `font-display: swap` : sans preload,
      le navigateur ne les découvre qu'après avoir téléchargé puis analysé la
      feuille de styles, ce qui garantit un FOUT sur le H1.

      Règle appliquée : on précharge les fontes qui peignent du texte de plus
      de 16px au-dessus de la ligne de flottaison, plus la graisse par défaut
      du corps. Trois fichiers, ~52 Ko :
        - Bold 700  : le H1 « CYBER TOUR // REUNION » (le markup demande 800,
                      aucune face 800 n'existe, le navigateur retombe sur 700)
                      et le bouton principal.
        - Demi 600  : la ligne date / lieu et les deux CTA du hero.
        - Bk 400    : graisse par défaut de <body>, donc le corps de texte
                      au-dessus de la ligne de flottaison des pages étape.

      Volontairement NON préchargées :
        - Md 500 (ITC Avant Garde)  : uniquement les 9 micro-liens de la nav.
        - JetBrains Mono            : labels ≤ 12px, et c'est le plus lourd
                                      fichier du lot — le précharger
                                      retarderait les fontes de titrage.
        - Ambroise                  : sous la ligne de flottaison, décorative.
      Précharger les sept fontes serait pire que n'en précharger aucune : la
      bande passante du premier rendu se répartirait au lieu de se concentrer.

      `crossorigin` est obligatoire même en same-origin : les fontes sont
      toujours récupérées en mode CORS. Sans lui le preload est ignoré et le
      fichier est téléchargé deux fois.
    */}
    <link
      rel="preload"
      href="/fonts/ITCAvantGardeStdBold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ITCAvantGardeStdDemi.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ITCAvantGardeStdBk.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="CLUSIR Réunion Océan Indien" />
    <meta name="keywords" content="cybersécurité, La Réunion, conférence, cybermois, CLUSIR, sécurité informatique, SOC, IA, souveraineté numérique" />

    <!-- OG Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Cyber Tour Réunion" />
    <meta property="og:image" content="https://cybertour.re/assets/og-cybertour-2026.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cyber Tour Réunion 2026 - 20-23 Octobre - 3 étapes" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://cybertour.re/assets/og-cybertour-2026.png" />

    <title>{title}</title>

    <!-- Privacy-friendly analytics by Plausible — instance on premise, sans cookie.
         Collecte étendue : sections de la home (#ancre) comme pages, liens sortants,
         téléchargements, formulaires, plus les événements « Contact email » et
         « Agenda ics » déclarés ci-dessous. Décrit dans /mentions-legales. -->
    <link rel="preconnect" href="https://plausible.kodetis.cloud" crossorigin />
    <script async src="https://plausible.kodetis.cloud/js/pa-6WvAN6_UyrWRAcamHXSvH.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init({
        hashBasedRouting: true,
        outboundLinks: true,
        fileDownloads: true,
        formSubmissions: true
      });

      // Clic sur un lien de contact : l'objet pré-rempli dit quelle demande
      // (dossier partenaire, palier, inscriptions…) — le mailto: lui-même
      // n'est pas un lien sortant pour Plausible.
      document.addEventListener('click', function (event) {
        var target = event.target instanceof Element ? event.target.closest('a[href^="mailto:"]') : null;
        if (!target) return;
        var sujet = '';
        try { sujet = new URL(target.getAttribute('href')).searchParams.get('subject') || ''; } catch (_) {}
        plausible('Contact email', {
          props: { sujet: sujet || '(sans objet)', page: location.pathname + location.hash }
        });
      });
    </script>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Event",
      "name": "Cyber Tour Réunion 2026",
      "description": "L'événement cybersécurité de référence à La Réunion, organisé par le CLUSIR Réunion Océan Indien.",
      "startDate": "2026-10-20T08:00:00+04:00",
      "endDate": "2026-10-23T18:00:00+04:00",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/MixedEventAttendanceMode",
      "location": [
        {
          "@type": "Place",
          "name": "Campus du Moufia — Université de La Réunion",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Allée des Aigues-Marines",
            "addressLocality": "Sainte-Clotilde",
            "postalCode": "97490",
            "addressRegion": "La Réunion",
            "addressCountry": "FR"
          }
        },
        {
          "@type": "Place",
          "name": "Office de l'Eau Réunion",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Saint-Paul",
            "addressRegion": "La Réunion",
            "addressCountry": "FR"
          }
        },
        {
          "@type": "Place",
          "name": "IUT de La Réunion / ESIROI",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "40 avenue de Soweto",
            "addressLocality": "Saint-Pierre",
            "postalCode": "97410",
            "addressRegion": "La Réunion",
            "addressCountry": "FR"
          }
        }
      ],
      "image": "https://cybertour.re/assets/og-cybertour-2026.png",
      "organizer": {
        "@type": "Organization",
        "name": "CLUSIR Réunion Océan Indien",
        "url": "https://clusir-roi.org"
      },
      "isAccessibleForFree": true,
      "inLanguage": "fr"
    })} />
  </head>
  <body class="font-body antialiased pb-10">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:bg-gold focus:text-navy-dark focus:px-4 focus:py-2 focus:rounded-lg focus:font-bold">
      Aller au contenu principal
    </a>
    <slot />

    <script>
      // ── Scroll reveal — IntersectionObserver only (aucun listener scroll,
      //    donc aucun reflow synchrone forcé par getBoundingClientRect).
      const revealEls = document.querySelectorAll('.reveal, .reveal-left, .reveal-right');

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0, rootMargin: '0px 0px -8% 0px' }
        );
        // L'observation déclenche un premier callback dès le prochain frame :
        // tout ce qui est déjà dans le viewport est révélé au chargement.
        revealEls.forEach((el) => observer.observe(el));
      } else {
        // Pas d'IntersectionObserver : on révèle tout plutôt que de laisser
        // le contenu invisible (opacity: 0 par défaut).
        revealEls.forEach((el) => el.classList.add('visible'));
      }

      // ── Compte à rebours (présent uniquement sur la home)
      // Les effets navbar (scroll + menu mobile) sont gérés dans Navbar.astro.
      const EVENT_START = new Date('2026-10-20T08:00:00+04:00').getTime();
      const EVENT_END = new Date('2026-10-23T18:00:00+04:00').getTime();

      const dEl = document.getElementById('cd-days');
      const hEl = document.getElementById('cd-hours');
      const mEl = document.getElementById('cd-mins');
      const sEl = document.getElementById('cd-secs');

      if (dEl && hEl && mEl && sEl) {
        // Conteneur du compte à rebours ; repli sur la remontée DOM si l'id manque
        const cdWrapper = document.getElementById('countdown')
          || (dEl.parentElement && dEl.parentElement.parentElement);
        let timerId = null;
        let settled = false; // true dès que l'état « en cours » / « terminé » est affiché

        function stopCountdown() {
          if (timerId !== null) {
            clearInterval(timerId);
            timerId = null;
          }
        }

        function renderStatus(title, subtitle, ctaLabel, ctaHref) {
          if (!cdWrapper) return;
          const box = document.createElement('div');
          box.className = 'mx-auto max-w-xl text-center';
          box.setAttribute('role', 'status');

          const h = document.createElement('p');
          h.className = 'font-mono text-xl sm:text-2xl font-bold uppercase tracking-widest text-gold';
          h.textContent = title;
          box.appendChild(h);

          const p = document.createElement('p');
          p.className = 'mt-2 text-sm text-white/70';
          p.textContent = subtitle;
          box.appendChild(p);

          if (ctaLabel && ctaHref) {
            const a = document.createElement('a');
            a.className = 'btn-outline text-xs py-2 px-5 mt-6 inline-block';
            a.href = ctaHref;
            a.textContent = ctaLabel;
            box.appendChild(a);
          }

          cdWrapper.replaceChildren(box);
          cdWrapper.classList.remove('flex', 'items-center', 'justify-center', 'gap-6', 'sm:gap-10');
          cdWrapper.classList.add('block');
        }

        function updateCountdown() {
          if (settled) return;
          const now = Date.now();

          if (now >= EVENT_END) {
            settled = true;
            stopCountdown();
            renderStatus(
              'Édition 2026 terminée',
              'Merci à toutes et tous. Les conférences sont disponibles en rediffusion.',
              'Voir les replays',
              '/#replay'
            );
            return;
          }

          if (now >= EVENT_START) {
            settled = true;
            stopCountdown();
            renderStatus(
              "L'événement est en cours",
              'Du 20 au 23 octobre 2026 — rejoignez-nous sur place ou en streaming.',
              'Voir les étapes',
              '/#etapes'
            );
            return;
          }

          const diff = EVENT_START - now;
          const days = Math.floor(diff / (1000 * 60 * 60 * 24));
          const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
          const secs = Math.floor((diff % (1000 * 60)) / 1000);

          dEl.textContent = String(days).padStart(3, '0');
          hEl.textContent = String(hours).padStart(2, '0');
          mEl.textContent = String(mins).padStart(2, '0');
          sEl.textContent = String(secs).padStart(2, '0');
        }

        function startCountdown() {
          updateCountdown();
          // updateCountdown() a pu arrêter le compteur (états « en cours » / « terminé »)
          if (timerId === null && !settled) {
            timerId = setInterval(updateCountdown, 1000);
          }
        }

        // Onglet caché : on suspend le tick (inutile et coûteux en batterie)
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'hidden') {
            stopCountdown();
          } else {
            startCountdown();
          }
        });

        if (document.visibilityState !== 'hidden') {
          startCountdown();
        } else {
          updateCountdown();
        }
      }
    </script>
  </body>
</html>
