---
import '../styles/global.css'
import { getLang, localizePath, alternatePath, otherLang, LANGS, OG_LOCALE, DEFAULT_LANG } from '../i18n';
import { ui } from '../i18n/ui';
/* Script de détection de la langue du navigateur, inliné tel quel dans <head>
   (import `?raw` de Vite) : il doit tourner avant le premier rendu, sans
   attendre un bundle. Fonction pure `decide()` + IIFE — voir le fichier. */
import redirectRaw from '../i18n/redirect.js?raw';
/* Thème clair / sombre, même principe : posé avant le premier rendu. */
import themeRaw from '../scripts/theme.js?raw';

/* Les commentaires du fichier source (documentation en français) ne partent
   pas dans le HTML public : on ne garde que le code. */
const stripComments = (src: string) =>
  src
    .replace(/\/\*[\s\S]*?\*\//g, '')
    .replace(/^\s*\/\/.*$/gm, '')
    .replace(/\n\s*\n+/g, '\n')
    .trim();
const redirectSrc = stripComments(redirectRaw);
const themeSrc = stripComments(themeRaw);

interface Props {
  title: string;
  description?: string;
}

const lang = getLang(Astro.currentLocale);
const t = ui[lang].layout;

const { title, description = t.defaultDescription } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

/* hreflang : chaque page annonce sa jumelle dans l'autre langue, et
   x-default pointe sur le français (langue par défaut, URL sans préfixe).
   C'est ce qui permet à Google de servir la bonne version malgré la
   redirection côté client, que les robots ne suivent pas forcément. */
const alternates = LANGS.map((l) => ({
  hreflang: l,
  href: new URL(alternatePath(Astro.url.pathname, l), Astro.site).href,
}));
const xDefault = new URL(alternatePath(Astro.url.pathname, DEFAULT_LANG), Astro.site).href;

---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline set:html={redirectSrc}></script>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f1a30" />
    <script is:inline set:html={themeSrc}></script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    {/*
      Préchargement des fontes — seulement les fontes du premier rendu.
      Toutes les fontes du site sont en `font-display: swap` : sans preload,
      le navigateur ne les découvre qu'après avoir téléchargé puis analysé la
      feuille de styles, ce qui garantit un FOUT sur le H1.

      Règle appliquée : on précharge les fontes qui peignent du texte de plus
      de 16px au-dessus de la ligne de flottaison, plus la graisse par défaut
      du corps. Trois fichiers, ~52 Ko :
        - Bold 700  : le H1 « CYBER TOUR // REUNION » (le markup demande 800,
                      aucune face 800 n'existe, le navigateur retombe sur 700)
                      et le bouton principal.
        - Demi 600  : la ligne date / lieu et les deux CTA du hero.
        - Bk 400    : graisse par défaut de <body>, donc le corps de texte
                      au-dessus de la ligne de flottaison des pages étape.

      Volontairement NON préchargées :
        - Md 500 (ITC Avant Garde)  : uniquement les 9 micro-liens de la nav.
        - JetBrains Mono            : labels ≤ 12px, et c'est le plus lourd
                                      fichier du lot — le précharger
                                      retarderait les fontes de titrage.
        - Ambroise                  : sous la ligne de flottaison, décorative.
      Précharger les sept fontes serait pire que n'en précharger aucune : la
      bande passante du premier rendu se répartirait au lieu de se concentrer.

      `crossorigin` est obligatoire même en same-origin : les fontes sont
      toujours récupérées en mode CORS. Sans lui le preload est ignoré et le
      fichier est téléchargé deux fois.
    */}
    <link
      rel="preload"
      href="/fonts/ITCAvantGardeStdBold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ITCAvantGardeStdDemi.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ITCAvantGardeStdBk.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="CLUSIR Réunion Océan Indien" />
    <meta name="keywords" content={t.keywords} />

    <!-- OG Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:locale:alternate" content={OG_LOCALE[otherLang(lang)]} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Cyber Tour Réunion" />
    <meta property="og:image" content="https://cybertour.re/assets/og-cybertour-2026.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://cybertour.re/assets/og-cybertour-2026.png" />

    <title>{title}</title>

    <!-- Privacy-friendly analytics by Plausible — instance on premise, sans cookie.
         Collecte étendue : sections de la home (#ancre) comme pages, liens sortants,
         téléchargements, plus les événements « Contact email » et « Agenda ics »
         déclarés ci-dessous. Décrit dans /mentions-legales. -->
    {/* Snippet public hits.kodetis.cloud + data-api, JAMAIS celui de la
        console : plausible.kodetis.cloud est le host privé Netbird-only,
        injoignable depuis Internet. Les options se déclarent dans le nom du
        script (hash, outbound-links, file-downloads). */}
    <link rel="preconnect" href="https://hits.kodetis.cloud" crossorigin />
    <script
      is:inline
      defer
      data-domain="cybertour.re"
      data-api="https://hits.kodetis.cloud/api/event"
      src="https://hits.kodetis.cloud/js/script.hash.outbound-links.file-downloads.js"
    ></script>
    <script is:inline>
      // File d'attente : les appels à plausible() faits avant le chargement
      // du script sont rejoués une fois qu'il est là.
      window.plausible=window.plausible||function(){(window.plausible.q=window.plausible.q||[]).push(arguments)};

      // Clic sur un lien de contact : l'objet pré-rempli dit quelle demande
      // (dossier partenaire, palier, inscriptions…) — le mailto: lui-même
      // n'est pas un lien sortant pour Plausible.
      document.addEventListener('click', function (event) {
        var target = event.target instanceof Element ? event.target.closest('a[href^="mailto:"]') : null;
        if (!target) return;
        var sujet = '';
        try { sujet = new URL(target.getAttribute('href')).searchParams.get('subject') || ''; } catch (_) {}
        plausible('Contact email', {
          props: { sujet: sujet || '(sans objet)', page: location.pathname + location.hash }
        });
      });
    </script>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Event",
      "name": "Cyber Tour Réunion 2026",
      "description": t.jsonLdDescription,
      "startDate": "2026-10-20T08:00:00+04:00",
      "endDate": "2026-10-30T18:00:00+04:00",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/MixedEventAttendanceMode",
      "location": [
        {
          "@type": "Place",
          "name": "Parc Technologique Universitaire (PTU) — Université de La Réunion",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "2 rue Joseph Wetzell",
            "addressLocality": "Sainte-Clotilde",
            "postalCode": "97490",
            "addressRegion": "La Réunion",
            "addressCountry": "FR"
          }
        },
        {
          "@type": "Place",
          "name": "Office de l'Eau Réunion",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Saint-Paul",
            "addressRegion": "La Réunion",
            "addressCountry": "FR"
          }
        },
        {
          "@type": "Place",
          "name": "IUT de La Réunion / ESIROI",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "40 avenue de Soweto",
            "addressLocality": "Saint-Pierre",
            "postalCode": "97410",
            "addressRegion": "La Réunion",
            "addressCountry": "FR"
          }
        },
        {
          "@type": "Place",
          "name": "Expernet",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Parc 2000, 3 avenue Théodore Drouhet",
            "addressLocality": "Le Port",
            "postalCode": "97420",
            "addressRegion": "La Réunion",
            "addressCountry": "FR"
          }
        },
        {
          "@type": "Place",
          "name": "École Du Numérique",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "12 rue Gabriel de Kerveguen",
            "addressLocality": "Sainte-Clotilde",
            "postalCode": "97490",
            "addressRegion": "La Réunion",
            "addressCountry": "FR"
          }
        }
      ],
      "image": "https://cybertour.re/assets/og-cybertour-2026.png",
      "organizer": {
        "@type": "Organization",
        "name": "CLUSIR Réunion Océan Indien",
        "url": "https://clusir-roi.org"
      },
      "isAccessibleForFree": true,
      "inLanguage": lang
    })} />
  </head>
  <body class="font-body antialiased pb-10">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:bg-gold focus:text-navy-dark focus:px-4 focus:py-2 focus:rounded-lg focus:font-bold">
      {t.skipToContent}
    </a>
    <slot />

    <script>
      // ── Scroll reveal — IntersectionObserver only (aucun listener scroll,
      //    donc aucun reflow synchrone forcé par getBoundingClientRect).
      const revealEls = document.querySelectorAll('.reveal, .reveal-left, .reveal-right');

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0, rootMargin: '0px 0px -8% 0px' }
        );
        // L'observation déclenche un premier callback dès le prochain frame :
        // tout ce qui est déjà dans le viewport est révélé au chargement.
        revealEls.forEach((el) => observer.observe(el));
      } else {
        // Pas d'IntersectionObserver : on révèle tout plutôt que de laisser
        // le contenu invisible (opacity: 0 par défaut).
        revealEls.forEach((el) => el.classList.add('visible'));
      }

    </script>
  </body>
</html>
