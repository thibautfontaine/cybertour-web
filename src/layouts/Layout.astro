---
import '../styles/global.css'

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Cyber Tour Réunion 2026 - 3 étapes, 20-23 Octobre 2026. Organisé par le CLUSIR Réunion Océan Indien." } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f1a30" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="CLUSIR Réunion Océan Indien" />
    <meta name="keywords" content="cybersécurité, La Réunion, conférence, cybermois, CLUSIR, sécurité informatique, SOC, IA, souveraineté numérique" />

    <!-- OG Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Cyber Tour Réunion" />
    <meta property="og:image" content="https://cybertour.re/assets/og-cybertour-2026.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cyber Tour Réunion 2026 - 20-23 Octobre - 3 étapes" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://cybertour.re/assets/og-cybertour-2026.png" />

    <title>{title}</title>

    <!-- Analytics -->
    <script data-goatcounter="https://cybertour.goatcounter.com/count"
            async src="//gc.zgo.at/count.js"></script>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Event",
      "name": "Cyber Tour Réunion 2026",
      "description": "L'événement cybersécurité de référence à La Réunion, organisé par le CLUSIR Réunion Océan Indien.",
      "startDate": "2026-10-20T08:00:00+04:00",
      "endDate": "2026-10-23T18:00:00+04:00",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/MixedEventAttendanceMode",
      "location": {
        "@type": "Place",
        "name": "IUT / ESIROI",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Saint-Pierre",
          "addressRegion": "La Réunion",
          "addressCountry": "FR"
        }
      },
      "image": "https://cybertour.re/assets/og-cybertour-2026.png",
      "organizer": {
        "@type": "Organization",
        "name": "CLUSIR Réunion Océan Indien",
        "url": "https://clusir-roi.org"
      },
      "isAccessibleForFree": true,
      "inLanguage": "fr"
    })} />
  </head>
  <body class="font-body antialiased overflow-x-hidden pb-10">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:bg-gold focus:text-navy-dark focus:px-4 focus:py-2 focus:rounded-lg focus:font-bold">
      Aller au contenu principal
    </a>
    <slot />

    <script>
      // ── Scroll reveal — IntersectionObserver only (aucun listener scroll,
      //    donc aucun reflow synchrone forcé par getBoundingClientRect).
      const revealEls = document.querySelectorAll('.reveal, .reveal-left, .reveal-right');

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0, rootMargin: '0px 0px -8% 0px' }
        );
        // L'observation déclenche un premier callback dès le prochain frame :
        // tout ce qui est déjà dans le viewport est révélé au chargement.
        revealEls.forEach((el) => observer.observe(el));
      } else {
        // Pas d'IntersectionObserver : on révèle tout plutôt que de laisser
        // le contenu invisible (opacity: 0 par défaut).
        revealEls.forEach((el) => el.classList.add('visible'));
      }

      // ── Compte à rebours (présent uniquement sur la home)
      // Les effets navbar (scroll + menu mobile) sont gérés dans Navbar.astro.
      const EVENT_START = new Date('2026-10-20T08:00:00+04:00').getTime();
      const EVENT_END = new Date('2026-10-23T18:00:00+04:00').getTime();

      const dEl = document.getElementById('cd-days');
      const hEl = document.getElementById('cd-hours');
      const mEl = document.getElementById('cd-mins');
      const sEl = document.getElementById('cd-secs');

      if (dEl && hEl && mEl && sEl) {
        // Conteneur du compte à rebours ; repli sur la remontée DOM si l'id manque
        const cdWrapper = document.getElementById('countdown')
          || (dEl.parentElement && dEl.parentElement.parentElement);
        let timerId = null;
        let settled = false; // true dès que l'état « en cours » / « terminé » est affiché

        function stopCountdown() {
          if (timerId !== null) {
            clearInterval(timerId);
            timerId = null;
          }
        }

        function renderStatus(title, subtitle, ctaLabel, ctaHref) {
          if (!cdWrapper) return;
          const box = document.createElement('div');
          box.className = 'mx-auto max-w-xl text-center';
          box.setAttribute('role', 'status');

          const h = document.createElement('p');
          h.className = 'font-mono text-xl sm:text-2xl font-bold uppercase tracking-widest text-gold';
          h.textContent = title;
          box.appendChild(h);

          const p = document.createElement('p');
          p.className = 'mt-2 text-sm text-white/70';
          p.textContent = subtitle;
          box.appendChild(p);

          if (ctaLabel && ctaHref) {
            const a = document.createElement('a');
            a.className = 'btn-outline text-xs py-2 px-5 mt-6 inline-block';
            a.href = ctaHref;
            a.textContent = ctaLabel;
            box.appendChild(a);
          }

          cdWrapper.replaceChildren(box);
          cdWrapper.classList.remove('flex', 'items-center', 'justify-center', 'gap-6', 'sm:gap-10');
          cdWrapper.classList.add('block');
        }

        function updateCountdown() {
          if (settled) return;
          const now = Date.now();

          if (now >= EVENT_END) {
            settled = true;
            stopCountdown();
            renderStatus(
              'Édition 2026 terminée',
              'Merci à toutes et tous. Les conférences sont disponibles en rediffusion.',
              'Voir les replays',
              '/#replay'
            );
            return;
          }

          if (now >= EVENT_START) {
            settled = true;
            stopCountdown();
            renderStatus(
              "L'événement est en cours",
              'Du 20 au 23 octobre 2026 — rejoignez-nous sur place ou en streaming.',
              'Voir les étapes',
              '/#etapes'
            );
            return;
          }

          const diff = EVENT_START - now;
          const days = Math.floor(diff / (1000 * 60 * 60 * 24));
          const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
          const secs = Math.floor((diff % (1000 * 60)) / 1000);

          dEl.textContent = String(days).padStart(3, '0');
          hEl.textContent = String(hours).padStart(2, '0');
          mEl.textContent = String(mins).padStart(2, '0');
          sEl.textContent = String(secs).padStart(2, '0');
        }

        function startCountdown() {
          updateCountdown();
          // updateCountdown() a pu arrêter le compteur (états « en cours » / « terminé »)
          if (timerId === null && !settled) {
            timerId = setInterval(updateCountdown, 1000);
          }
        }

        // Onglet caché : on suspend le tick (inutile et coûteux en batterie)
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'hidden') {
            stopCountdown();
          } else {
            startCountdown();
          }
        });

        if (document.visibilityState !== 'hidden') {
          startCountdown();
        } else {
          updateCountdown();
        }
      }
    </script>
  </body>
</html>
