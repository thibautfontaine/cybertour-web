---
import StageLayout from '../layouts/StageLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { stages } from '../data/stages';
const stage = stages.find(s => s.id === 'ouest')!;
---

<StageLayout stage={stage}>
  <Navbar slot="navbar" currentPage="ouest" />

  <!-- Programme section -->
  <section class="py-20">
    <div class="max-w-5xl mx-auto px-6">
      <div class="reveal">
        <span class="font-mono text-cyan-400/60 text-sm tracking-widest uppercase">Programme</span>
        <h2 class="font-display font-bold text-3xl sm:text-4xl mt-4">Offreurs Cyber à La Réunion</h2>
        <p class="text-white/50 mt-4 text-lg max-w-3xl">
          Journée dédiée à l'écosystème cyber réunionnais. Gestion de crise le matin, présentations thématiques
          par les offreurs locaux, puis atelier pratique l'après-midi.
        </p>
      </div>

      <!-- Format cards -->
      <div class="reveal delay-1 mt-14">
        <div class="grid sm:grid-cols-3 gap-6">
          {[
            { title: 'Gestion de crise', desc: "Méthodologie et retour d'expérience sur la gestion d'incidents cyber." },
            { title: 'Présentations thématiques', desc: 'Les offreurs locaux abordent des problématiques concrètes de cybersécurité.' },
            { title: 'Atelier pratique', desc: 'Exercice de gestion de crise en groupes, animé par le CLUSIR ROI.' },
          ].map(item => (
            <div class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6 hover:border-cyan-400/20 transition-colors">
              <h3 class="font-display font-semibold text-lg mb-2">{item.title}</h3>
              <p class="text-white/50 text-sm font-body">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Programme à venir -->
      <div class="reveal delay-2 mt-10">
        <div class="bg-cyan-400/[0.06] border border-cyan-400/[0.15] rounded-xl p-6 flex items-start gap-4">
          <div class="shrink-0 w-10 h-10 rounded-lg bg-cyan-400/10 flex items-center justify-center">
            <svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <h4 class="font-display font-semibold text-sm mb-1 text-cyan-400">Programme complet</h4>
            <p class="text-white/50 text-sm font-body">
              Le programme détaillé et la liste des intervenants seront publiés à l'approche de l'événement.
            </p>
          </div>
        </div>
      </div>

      <!-- Écosystème cyber réunionnais -->
      <div class="reveal delay-3 mt-12">
        <h3 class="font-display font-semibold text-xl mb-8">Écosystème cyber réunionnais représenté</h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
          {['Eyako', 'Exodata', 'Idom', 'OCD', 'SFR', 'MDSI', 'NXO'].map(name => (
            <div class="bg-white/[0.03] border border-white/[0.06] rounded-xl p-4 text-center hover:border-cyan-400/20 transition-colors">
              <span class="font-display font-semibold text-sm text-white/70">{name}</span>
            </div>
          ))}
        </div>
        <p class="text-white/50 text-xs font-mono mt-4">Le CLUSIR ROI ne recommande aucun produit ni prestataire. Cette étape présente l'écosystème cyber réunionnais dans sa diversité.</p>
      </div>

      <!-- Lieu d'accueil -->
      <div class="reveal delay-2 mt-12">
        <h3 class="font-display font-semibold text-xl mb-8">Lieu d'accueil</h3>
        <div class="flex flex-wrap items-center justify-center gap-8">
          <div class="partner-bubble px-6 py-3">
            <img src="/assets/logo-office-eau.png" alt="Office de l'Eau" class="h-16 sm:h-20 w-auto object-contain" loading="lazy" />
          </div>
        </div>
      </div>

      <!-- Afternoon note -->
      <div class="reveal delay-4 mt-10">
        <div class="bg-cyan-400/[0.06] border border-cyan-400/[0.15] rounded-xl p-6 flex items-start gap-4">
          <div class="shrink-0 w-10 h-10 rounded-lg bg-cyan-400/10 flex items-center justify-center">
            <svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
            </svg>
          </div>
          <div>
            <h4 class="font-display font-semibold text-sm mb-1 text-cyan-400">Après-midi</h4>
            <p class="text-white/50 text-sm font-body">
              Exercice pratique de gestion de crise en groupes, animé par le CLUSIR ROI avec le soutien du partenaire principal.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</StageLayout>
