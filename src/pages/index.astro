---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MapReunion from '../components/MapReunion.astro';
import TimelineParcours from '../components/TimelineParcours.astro';
import StageCard from '../components/StageCard.astro';
import PartnerPyramid from '../components/PartnerPyramid.astro';
import { stages } from '../data/stages';

const contactMail = 'evenement@clusir-roi.org';

/**
 * Pourquoi investir — les quatre piliers du dossier partenaire (V2.1, p.19),
 * repris mot pour mot. L'ordre est celui du dossier.
 */
const whyInvest = [
  {
    key: 'visibilite',
    title: 'Visibilité',
    text: "Associez votre entreprise à un événement fédérateur de l'écosystème cyber réunionnais et bénéficiez d'une visibilité auprès de décideurs, professionnels, experts et futurs talents.",
    icon: 'M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178zM15 12a3 3 0 11-6 0 3 3 0 016 0z',
  },
  {
    key: 'reseau',
    title: 'Réseau',
    text: "Rencontrez les acteurs de l'écosystème cyber : entreprises, institutions, experts, professionnels et intervenants nationaux.",
    icon: 'M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z',
  },
  {
    key: 'expertise',
    title: 'Expertise',
    text: "Valorisez vos compétences et vos collaborateurs en contribuant aux conférences, ateliers, retours d'expérience ou temps d'échange du CyberTour.",
    icon: 'M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18',
  },
  {
    key: 'talents',
    title: 'Talents',
    text: "Rencontrez les étudiants et futurs professionnels issus des formations locales et développez votre attractivité auprès des talents du numérique et de la cybersécurité.",
    icon: 'M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5',
  },
];

/**
 * Paliers de partenariat — ordre croissant de prix.
 *
 * Bronze, Silver et Gold reprennent le dossier partenaire V2.1 (p.20-22) :
 * axe (Soutenir / Être présent / Contribuer), tagline et contreparties, mot
 * pour mot. Les contreparties marquées « * » sont soumises à la réserve du
 * comité d'organisation (note de bas de page du dossier).
 *
 * Le sujet du mailto reprend la forme utilisée par PartnerPyramid.astro
 * (« Sponsoring <Palier> — <prix> ») pour que la demande arrive qualifiée.
 */
const sponsorTiers = [
  {
    key: 'bronze',
    name: 'Bronze',
    axis: 'Soutenir',
    price: '1 000 €',
    note: 'À partir de',
    tagline: "Pour les entreprises qui souhaitent associer leur image à l'événement et soutenir son développement.",
    includes: null,
    benefits: [
      'Mention comme partenaire du CyberTour',
      "Logo affiché sur le site internet de l'événement",
      'Logo intégré aux supports de communication',
      'Mention du partenariat dans les publications relatives au CyberTour',
      'Kit de communication partenaire (selon les supports et éléments disponibles)',
    ],
    text: 'text-amber-500',
    border: 'border-amber-700/50',
    bg: 'bg-amber-900/20',
    hover: 'hover:bg-amber-900/30',
    bar: 'from-amber-700 to-amber-900',
    cardBorder: 'border-amber-900/30',
    subject: 'Sponsoring Bronze — 1 000 €',
  },
  {
    key: 'silver',
    name: 'Silver',
    axis: 'Être présent',
    price: '3 000 €',
    note: 'À partir de',
    tagline: 'Pour les entreprises qui souhaitent aller au-delà du soutien et rencontrer directement les participants.',
    includes: 'Tous les avantages de la formule Bronze',
    benefits: [
      "Présence identifiée comme partenaire sur le lieu de l'événement",
      "Jusqu'à 2 supports de visibilité (type kakémono) sur une étape",
      "Goodies aux couleurs de l'entreprise intégrés aux dotations de l'événement",
      'Espace partenaire pour échanger avec les étudiants et futurs talents',
    ],
    text: 'text-gray-300',
    border: 'border-gray-400/50',
    bg: 'bg-gray-400/10',
    hover: 'hover:bg-gray-400/20',
    bar: 'from-gray-300 to-gray-500',
    cardBorder: 'border-gray-400/30',
    subject: 'Sponsoring Silver — 3 000 €',
  },
  {
    key: 'gold',
    name: 'Gold',
    axis: 'Contribuer',
    price: '5 000 €',
    note: 'À partir de',
    tagline: "Pour les entreprises qui souhaitent valoriser leur expertise et contribuer activement au contenu de l'événement.",
    includes: 'Tous les avantages de la formule Silver',
    benefits: [
      "Temps d'introduction (2 min max)*",
      "Co-branding d'un atelier ou d'une séquence* : « Atelier présenté par [Entreprise] » ou « Atelier organisé en partenariat avec [Entreprise] »",
      "Contribution au contenu d'un atelier ou d'une séquence thématique*",
      "Mobilisation de vos collaborateurs pour intervenir lors d'une étape ou partager un retour d'expérience*",
    ],
    text: 'text-gold',
    border: 'border-gold/50',
    bg: 'bg-gold/10',
    hover: 'hover:bg-gold/20',
    bar: 'from-gold-dim to-gold',
    cardBorder: 'border-gold/30',
    subject: 'Sponsoring Gold — 5 000 €',
  },
];

/** Réserve du dossier partenaire (p.22) sur les contreparties marquées « * ». */
const sponsorFootnote =
  "* Sous réserve de validation par le comité d'organisation et selon le format et le programme.";

/** Chiffres de l'édition 2025, repris tels quels de la section « Replay ». */
const audience2025 = [
  { value: '220', label: 'Participants' },
  { value: '150', label: 'En présentiel' },
  { value: '600+', label: 'Vues replay' },
  { value: '2', label: 'Retombées presse' },
];

const mailtoSubject = (subject) =>
  `mailto:${contactMail}?subject=${encodeURIComponent(subject)}`;
---

<Layout title="Cyber Tour Réunion 2026 | 20-29 Octobre - 6 Étapes">

  <!-- ===== NAVBAR ===== -->
  <Navbar />

  <!-- ===== HERO ===== -->
  <section id="main-content" class="relative min-h-dvh flex items-center justify-center overflow-hidden">
    <!-- Background image with overlay -->
    <div class="absolute inset-0">
      <img src="/assets/hero-bg.jpg" alt="" width="1920" height="1080" class="w-full h-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-b from-navy-dark/80 via-navy-dark/70 to-navy-dark"></div>
    </div>

    <!-- Grid overlay -->
    <div class="absolute inset-0 cyber-grid"></div>

    <!-- Scan line effect -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="absolute left-0 right-0 h-px bg-gold/20 animate-scan"></div>
    </div>

    <!-- Glow orbs -->
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-navy rounded-full animate-pulse-glow"></div>
    <div class="absolute bottom-1/4 right-1/4 w-64 h-64 bg-gold/20 rounded-full animate-pulse-glow" style="animation-delay: 2s;"></div>

    <!-- Floating island silhouette -->
    <div class="absolute right-0 bottom-0 w-[500px] h-[500px] opacity-[0.06] animate-float pointer-events-none">
      <img src="/assets/reunion-silhouette.png" alt="" class="w-full h-full object-contain" />
    </div>

    <!-- Hero content -->
    <div class="relative z-10 text-center px-6 max-w-5xl mx-auto">
      <!-- Event badge -->
      <div class="inline-flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-5 py-2 mb-8" style="animation: slide-up 0.8s ease-out both;">
        <span class="w-2 h-2 bg-gold rounded-full animate-pulse"></span>
        <span class="text-sm font-mono text-white/60 tracking-widest uppercase">Cybermois 2026 &mdash; La Réunion</span>
      </div>

      <!-- Main title -->
      <h1 class="font-display font-extrabold leading-[0.95] mb-6" style="animation: slide-up 0.8s ease-out 0.15s both;">
        <span class="glitch-wrapper block">
          <span class="glitch text-6xl sm:text-7xl md:text-8xl lg:text-9xl tracking-tight text-white" data-text="CYBER">CYBER</span>
        </span>
        <span class="block text-6xl sm:text-7xl md:text-8xl lg:text-9xl tracking-tight">
          <span class="text-gold">TOUR</span>
          <span class="text-white/20 ml-2 md:ml-4" aria-hidden="true">&#47;&#47;</span>
        </span>
        <span class="block text-3xl sm:text-4xl md:text-5xl tracking-[0.2em] mt-4 reunion-outline">REUNION</span>
      </h1>

      <!-- Date & location -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-8 mb-10" style="animation: slide-up 0.8s ease-out 0.3s both;">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <span class="font-display font-semibold text-lg tracking-wide">20 &mdash; 29 OCTOBRE 2026</span>
        </div>
        <span class="hidden sm:block w-1 h-1 bg-gold rounded-full"></span>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span class="font-display font-semibold text-lg tracking-wide">3 ÉTAPES &middot; TOUTE L'ILE</span>
        </div>
      </div>

      <!-- CTA buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4" style="animation: slide-up 0.8s ease-out 0.45s both;">
        <a href="#etapes" class="btn-primary rounded-lg font-display">Découvrir le parcours</a>
        <a href="#contact" class="btn-outline rounded-lg font-display text-sm">Contact</a>
      </div>

      <!-- Context pills — qualification rapide pour le visiteur -->
      <div class="flex flex-wrap items-center justify-center gap-3 mt-6" style="animation: slide-up 0.8s ease-out 0.55s both;">
        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-mono tracking-wider border border-emerald-400/25 bg-emerald-400/[0.07] text-emerald-400">
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 13l4 4L19 7"/></svg>
          Entrée gratuite
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-mono tracking-wider border border-gold/25 bg-gold/[0.07] text-gold">
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Places limitées
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-mono tracking-wider border border-white/15 bg-white/[0.05] text-white/60">
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
          Présentiel + streaming
        </span>
      </div>

      <!-- Countdown -->
      <div id="countdown" class="mt-16 flex items-center justify-center gap-6 sm:gap-10" style="animation: slide-up 0.8s ease-out 0.6s both;">
        <div class="text-center">
          <span id="cd-days" class="block font-mono text-3xl sm:text-4xl font-bold text-gold tabular-nums">---</span>
          <span class="text-xs text-white/55 uppercase tracking-widest">Jours</span>
        </div>
        <span class="text-white/20 text-2xl font-light" aria-hidden="true">:</span>
        <div class="text-center">
          <span id="cd-hours" class="block font-mono text-3xl sm:text-4xl font-bold text-white tabular-nums">--</span>
          <span class="text-xs text-white/55 uppercase tracking-widest">Heures</span>
        </div>
        <span class="text-white/20 text-2xl font-light" aria-hidden="true">:</span>
        <div class="text-center">
          <span id="cd-mins" class="block font-mono text-3xl sm:text-4xl font-bold text-white tabular-nums">--</span>
          <span class="text-xs text-white/55 uppercase tracking-widest">Min</span>
        </div>
        <span class="text-white/20 text-2xl font-light" aria-hidden="true">:</span>
        <div class="text-center">
          <span id="cd-secs" class="block font-mono text-3xl sm:text-4xl font-bold text-white/50 tabular-nums">--</span>
          <span class="text-xs text-white/55 uppercase tracking-widest">Sec</span>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/50">
      <span class="text-xs tracking-widest uppercase">Scroll</span>
      <div class="w-px h-8 bg-gradient-to-b from-white/30 to-transparent"></div>
    </div>
  </section>

  <!-- ===== ABOUT ===== -->
  <section id="about" class="relative py-32 overflow-hidden">
    <div class="absolute inset-0 noise-overlay"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6">
      <!-- Section header -->
      <div class="reveal mb-20">
        <span class="section-label">01 // À propos</span>
        <h2 class="section-title mt-4">
          L'événement cyber<br/><span class="text-gold">de référence</span> à La Réunion
        </h2>
      </div>

      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <!-- Text block -->
        <div class="space-y-8">
          <p class="reveal delay-1 text-lg text-white/70 leading-relaxed">
            <strong class="text-white font-semibold">Quatre jours. Trois étapes. Toute l'île.</strong>
            Le <strong class="text-white font-semibold">Cyber Tour Réunion</strong> est le rendez-vous annuel
            de la cybersécurité à La Réunion. Organisé dans le cadre du
            <strong class="text-gold font-semibold">Cybermois</strong> par le
            <strong class="text-white font-semibold">CLUSIR Réunion Océan Indien</strong>,
            il réunit décideurs, professionnels et étudiants autour d'un objectif commun :
            renforcer la résilience numérique du territoire.
          </p>
          <p class="reveal delay-2 text-lg text-white/70 leading-relaxed">
            En 2025 : <strong class="text-white font-semibold">220 participants</strong>,
            <strong class="text-white font-semibold">600 vues</strong> en replay,
            <strong class="text-white font-semibold">2 articles</strong> dans Le Quotidien.
            En 2026, le format s'élargit : 6 étapes sur les quatre façades de l'île, portées par le CLUSIR et par des organisateurs locaux.
          </p>

          <!-- Stats -->
          <div class="reveal delay-3 grid grid-cols-3 gap-6 pt-6">
            <div class="text-center p-4 bg-white/[0.03] border border-white/[0.06] rounded-xl">
              <span class="block font-display font-extrabold text-3xl text-gold">3</span>
              <span class="text-sm text-white/50 mt-1">Étapes</span>
            </div>
            <div class="text-center p-4 bg-white/[0.03] border border-white/[0.06] rounded-xl">
              <span class="block font-display font-extrabold text-3xl text-gold">4</span>
              <span class="text-sm text-white/50 mt-1">Jours</span>
            </div>
            <div class="text-center p-4 bg-white/[0.03] border border-white/[0.06] rounded-xl">
              <span class="block font-display font-extrabold text-3xl text-gold">600+</span>
              <span class="text-sm text-white/50 mt-1">Vues YouTube</span>
            </div>
          </div>
        </div>

        <!-- Visual block -->
        <div class="reveal-right delay-2 relative">
          <div class="relative rounded-2xl overflow-hidden border border-white/10">
            <img src="/assets/cybertour-asset-web-site.png" alt="Cyber Tour Réunion" class="w-full h-auto" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-dark/60 to-transparent"></div>
          </div>
          <!-- Decorative shield -->
          <div class="absolute -top-8 -right-8 w-24 h-24 text-gold/20 animate-float" style="animation-delay: 1s;">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2L3 7v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-9-5z"/>
            </svg>
          </div>
          <!-- Glow -->
          <div class="absolute -bottom-12 -left-12 w-48 h-48 bg-navy rounded-full blur-[80px] opacity-60"></div>
        </div>
      </div>

      <!-- P3 — Micro-CTA vers le parcours -->
      <div class="reveal delay-4 flex items-center justify-center mt-16 pt-10 border-t border-white/[0.05]">
        <a
          href="#etapes"
          class="group inline-flex items-center gap-3 py-3 font-mono text-sm text-white/50 hover:text-gold transition-colors duration-200 tracking-wide"
        >
          <span>Voir les 6 étapes du tour</span>
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== RETOUR SUR 2025 ===== -->
  <section id="replay" class="relative py-32 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-navy-dark via-slate-deep to-navy-dark"></div>
    <div class="absolute inset-0 cyber-grid opacity-20"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-6">
      <div class="reveal text-center mb-14">
        <span class="section-label">02 // Replay</span>
        <h2 class="section-title mt-4">
          Édition <span class="text-gold">2025</span>
        </h2>
        <p class="text-white/50 mt-4 max-w-2xl mx-auto text-lg">
          Revivez les conférences de l'édition précédente en intégralité.
        </p>
      </div>

      <!-- Stats 2025 -->
      <div class="reveal delay-1 grid grid-cols-3 gap-6 max-w-2xl mx-auto mb-12">
        <div class="text-center p-4 bg-white/[0.03] border border-white/[0.06] rounded-xl">
          <span class="block font-display font-extrabold text-3xl text-gold">220</span>
          <span class="text-sm text-white/50 mt-1">Participants</span>
        </div>
        <div class="text-center p-4 bg-white/[0.03] border border-white/[0.06] rounded-xl">
          <span class="block font-display font-extrabold text-3xl text-gold">150</span>
          <span class="text-sm text-white/50 mt-1">En présentiel</span>
        </div>
        <div class="text-center p-4 bg-white/[0.03] border border-white/[0.06] rounded-xl">
          <span class="block font-display font-extrabold text-3xl text-gold">600+</span>
          <span class="text-sm text-white/50 mt-1">Vues replay</span>
        </div>
      </div>

      <div class="reveal delay-2">
        <div class="relative rounded-2xl overflow-hidden border border-white/10 shadow-2xl shadow-navy/50 aspect-video">
          <iframe
            src="https://www.youtube-nocookie.com/embed/uk-gSyaxyWA?start=9748"
            title="Cyber Tour Réunion 2025 - Replay"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
            class="absolute inset-0 w-full h-full"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CARTE DU TOUR / ÉTAPES ===== -->
  <section id="etapes" class="relative py-32 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-deep to-navy-dark"></div>
    <div class="absolute inset-0 cyber-grid opacity-50"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6">
      <div class="reveal mb-16 text-center">
        <span class="section-label">03 // Le Parcours</span>
        <h2 class="section-title mt-4">
          6 étapes, 6 organisateurs, <span class="text-gold">un seul tour</span>
        </h2>
        <p class="text-white/50 mt-4 max-w-2xl mx-auto text-lg">
          Du 20 au 29 octobre, la cybersécurité fait le tour de l'île — portée
          par le CLUSIR sur trois étapes, par des organisateurs locaux sur trois
          autres. Même label, même exigence, même agenda.
        </p>
        <!-- C4 — Dates bien visibles -->
        <div class="inline-flex items-center gap-2 mt-6 px-4 py-2 rounded-full border border-gold/20 bg-gold/[0.06]">
          <svg class="w-4 h-4 text-gold/70 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
