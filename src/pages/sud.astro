---
import StageLayout from '../layouts/StageLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { stages } from '../data/stages';
const stage = stages.find(s => s.id === 'sud')!;

const ateliers = [
  {
    icon: '\u{1F3F4}',
    title: 'CTF',
    desc: "CTF attack/defense sur la journée entière. Deux équipes s'affrontent : l'une attaque, l'autre défend ses services. Format dynamique, pression réelle.",
  },
  {
    icon: '\u{1F510}',
    title: 'Escape Game Cyber Reunion',
    desc: 'Escape game immersif sur le thème de la cybersécurité, conçu par Cyber Reunion.',
  },
  {
    icon: '\u{1F6A8}',
    title: 'Gestion de crise',
    desc: "Simulation de gestion d'incident cyber en conditions réelles. 4 à 6 groupes, sessions matin et après-midi.",
  },
  {
    icon: '\u{1F50D}',
    title: 'Atelier technique',
    desc: 'Atelier technique approfondi — investigation numérique en sources ouvertes et autres thématiques pratiques.',
  },
  {
    icon: '\u{1F3A4}',
    title: 'Rumps — Scène ouverte',
    desc: "Présentations libres de 5 à 10 minutes. Partagez un projet, un outil, un retour d'expérience.",
  },
  {
    icon: '\u{1F4BC}',
    title: 'Rencontres professionnelles',
    desc: "Rencontres sponsors en one-to-one et atelier de recherche de stage avec les entreprises présentes.",
  },
];
---

<StageLayout stage={stage}>
  <Navbar slot="navbar" currentPage="sud" />

  <!-- Floating day navigator -->
  <nav id="day-nav" aria-label="Navigation par jour" class="fixed left-5 top-1/2 translate-y-20 z-40 hidden lg:flex flex-col items-center gap-1 pointer-events-none opacity-0 transition-opacity duration-300">
    {[
      { href: '#day-1', label: 'Jour 1 — Jeudi 22' },
      { href: '#day-2', label: 'Jour 2 — Vendredi 23' },
    ].map((item, i) => (
      <div class="flex flex-col items-center">
        <a href={item.href} class="dnav-item group relative flex items-center pointer-events-auto">
          <span class="dnav-dot block w-2 h-2 rounded-full transition-all duration-200" style="background:rgba(255,255,255,0.15);"></span>
          <span class="pointer-events-none absolute left-5 whitespace-nowrap font-mono text-[11px] tracking-widest uppercase px-3 py-1.5 rounded-lg border border-white/[0.08] opacity-0 group-hover:opacity-100 transition-opacity duration-150"
            style="color:rgba(255,255,255,0.6);background:rgba(10,18,32,0.95);">
            {item.label}
          </span>
        </a>
        {i === 0 && <span class="block w-px my-1.5 rounded-full" style="height:16px;background:rgba(255,255,255,0.08);"></span>}
      </div>
    ))}
  </nav>

  <!-- Two-day programme -->
  <section id="programme" class="py-20">
    <div class="max-w-5xl mx-auto px-6">

      <!-- Jour 1: Conférences techniques -->
      <div class="day-section" id="day-1">
        <div class="reveal">
          <span class="font-mono text-red-400/60 text-sm tracking-widest uppercase">Jour 1 — Jeudi 22 octobre</span>
          <h2 class="font-display font-bold text-3xl sm:text-4xl mt-4">Conférences techniques</h2>
          <p class="text-white/50 mt-4 text-lg max-w-3xl">
            Une journée de conférences animées par des experts en cybersécurité. Retours d'expérience,
            présentations techniques et échanges avec la communauté.
          </p>
        </div>

        <!-- Audience note -->
        <div class="reveal delay-2 mt-8">
          <div class="bg-red-400/[0.06] border border-red-400/[0.15] rounded-xl p-5 flex items-start gap-4">
            <div class="shrink-0 w-10 h-10 rounded-lg bg-red-400/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <h4 class="font-display font-semibold text-sm mb-1 text-red-400">Public</h4>
              <p class="text-white/50 text-sm font-body">Étudiants et professionnels de l'IT</p>
            </div>
          </div>
        </div>

        <!-- Thématiques J1 -->
        <div class="reveal delay-3 mt-10">
          <div class="grid sm:grid-cols-2 gap-6">
            {[
              { title: 'Souveraineté numérique', desc: 'Cloud de confiance, enjeux locaux et cadre réglementaire européen.' },
              { title: 'Sécurité des systèmes IA', desc: "OWASP Top 10 GenAI, risques de l'IA générative, protection des modèles." },
              { title: 'SOC, défense proactive & Zero Trust', desc: 'Architectures Zero Trust, détection proactive, chiffrement du code source.' },
              { title: 'RETEX Cyber', desc: "Retour d'expérience sur la gestion d'une crise cyber réelle." },
            ].map(item => (
              <div class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6 hover:border-red-400/20 transition-colors">
                <h3 class="font-display font-semibold text-lg mb-2">{item.title}</h3>
                <p class="text-white/50 text-sm font-body">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Programme J1 à venir -->
        <div class="reveal delay-4 mt-8">
          <div class="bg-red-400/[0.06] border border-red-400/[0.15] rounded-xl p-6 flex items-start gap-4">
            <div class="shrink-0 w-10 h-10 rounded-lg bg-red-400/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h4 class="font-display font-semibold text-sm mb-1 text-red-400">Programme complet</h4>
              <p class="text-white/50 text-sm font-body">
                Le programme détaillé et la liste des intervenants seront publiés à l'approche de l'événement.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Day separator -->
      <div class="reveal my-24 flex items-center gap-6">
        <div class="flex-1 h-px bg-white/[0.06]"></div>
        <div class="flex items-center gap-3">
          <div class="w-1.5 h-1.5 rounded-full bg-red-400/40"></div>
          <span class="font-mono text-xs text-white/25 tracking-widest uppercase">Vendredi 23 octobre</span>
          <div class="w-1.5 h-1.5 rounded-full bg-red-400/40"></div>
        </div>
        <div class="flex-1 h-px bg-white/[0.06]"></div>
      </div>

      <!-- Jour 2: Ateliers pratiques -->
      <div class="day-section" id="day-2">
        <div class="reveal">
          <span class="font-mono text-red-400/60 text-sm tracking-widest uppercase">Jour 2 — Vendredi 23 octobre</span>
          <h2 class="font-display font-bold text-3xl sm:text-4xl mt-4">Ateliers pratiques</h2>
          <p class="text-white/50 mt-4 text-lg max-w-3xl">
            Une journée les mains dans le clavier. Quatre ateliers en parallèle pour expérimenter
            la cybersécurité de manière concrète et ludique.
          </p>
        </div>

        <!-- Groups note -->
        <div class="reveal delay-2 mt-8">
          <div class="bg-red-400/[0.06] border border-red-400/[0.15] rounded-xl p-5 flex items-start gap-4">
            <div class="shrink-0 w-10 h-10 rounded-lg bg-red-400/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <h4 class="font-display font-semibold text-sm mb-1 text-red-400">Organisation</h4>
              <p class="text-white/50 text-sm font-body">Sessions en groupes de 4 à 6, matin et après-midi</p>
            </div>
          </div>
        </div>

        <!-- Atelier cards -->
        <div class="reveal delay-3 mt-10">
          <h3 class="font-display font-semibold text-xl mb-6">Les ateliers</h3>
          <div class="grid sm:grid-cols-2 gap-6">
            {ateliers.map(atelier => (
              <div class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6 hover:border-red-400/20 transition-colors">
                <div class="text-3xl mb-4">{atelier.icon}</div>
                <h3 class="font-display font-semibold text-lg mb-2">{atelier.title}</h3>
                <p class="text-white/50 text-sm font-body">{atelier.desc}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Appel à soumission Rumps -->
        <div class="reveal delay-4 mt-10">
          <div class="bg-red-400/[0.06] border border-red-400/[0.15] rounded-2xl p-8 text-center">
            <h3 class="font-display font-bold text-2xl mb-3">Appel à soumission — Scène ouverte (Rumps)</h3>
            <p class="text-white/50 text-sm font-body max-w-xl mx-auto mb-6">
              Vous avez un projet, un outil, un retour d'expérience à partager ?
              Proposez une présentation de 5 à 10 minutes lors de la scène ouverte du CyberTour.
            </p>
            <a href="mailto:evenement@clusir-roi.org?subject=Soumission%20Rumps%20CyberTour%202026" class="btn-primary inline-flex items-center gap-3 rounded-xl">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              Soumettre une présentation
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Co-organisateurs -->
  <section class="py-16">
    <div class="max-w-5xl mx-auto px-6">
      <div class="reveal">
        <h3 class="font-display font-semibold text-xl mb-8">Co-organisateurs</h3>
        <div class="flex flex-wrap items-center justify-center gap-8">
          <div class="partner-bubble px-6 py-3">
            <img src="/assets/logo-univ-reunion.png" alt="Universite de La Réunion" class="h-16 sm:h-20 w-auto object-contain" loading="lazy" />
          </div>
          <div class="partner-bubble px-6 py-3">
            <img src="/assets/logo-clusir.png" alt="CLUSIR Réunion Océan Indien" class="h-16 sm:h-20 w-auto object-contain" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</StageLayout>

<style>
  .dnav-item:hover .dnav-dot,
  .dnav-item:focus-visible .dnav-dot { background: rgba(255,255,255,0.45) !important; }
  .dnav-item.active .dnav-dot {
    background: #DF3C37 !important;
    box-shadow: 0 0 8px rgba(223,60,55,0.5);
  }
  .dnav-item:focus-visible { outline: none; }
</style>

<script>
  const nav = document.getElementById('day-nav');
  const programme = document.getElementById('programme');
  const navBtns = document.querySelectorAll<HTMLAnchorElement>('.dnav-item');
  const sections = document.querySelectorAll<HTMLElement>('.day-section');

  const programmeObserver = new IntersectionObserver(
    ([entry]) => {
      if (!nav) return;
      if (entry.isIntersecting) {
        nav.style.opacity = '1';
        nav.style.pointerEvents = 'auto';
      } else {
        nav.style.opacity = '0';
        nav.style.pointerEvents = 'none';
      }
    },
    { threshold: 0, rootMargin: '-80px 0px -20px 0px' }
  );
  if (programme) programmeObserver.observe(programme);

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          navBtns.forEach(btn => {
            const href = btn.getAttribute('href');
            btn.classList.toggle('active', href === `#${id}`);
          });
        }
      });
    },
    { threshold: 0.15, rootMargin: '-80px 0px -40% 0px' }
  );
  sections.forEach(s => sectionObserver.observe(s));

  navBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const target = document.querySelector(btn.getAttribute('href') ?? '');
      if (target) {
        const offset = 80;
        const top = target.getBoundingClientRect().top + window.scrollY - offset;
        window.scrollTo({ top, behavior: 'smooth' });
      }
    });
  });
</script>
