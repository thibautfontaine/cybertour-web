---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { stages } from '../data/stages';

const accent = '#5b8cc9';

const pageTitle = "Étape Est — le format 2026 a changé | Cyber Tour Réunion 2026";
const pageDesc =
  "L'étape Est ne figure pas au programme du Cyber Tour Réunion 2026. Le parcours se concentre sur trois étapes : Nord, Ouest et Sud, du 20 au 23 octobre 2026.";
---

<Layout title={pageTitle} description={pageDesc}>
  <Navbar />

  <div style={`--stage-accent: ${accent};`} class="pb-16">

    <!-- ===== HERO ===== -->
    <section id="main-content" class="relative overflow-hidden pt-32 pb-16">
      <div
        class="absolute inset-0"
        style={`background: linear-gradient(135deg, #0f1a30 0%, ${accent}12 50%, #0f1a30 100%);`}
      ></div>
      <div class="absolute inset-0 cyber-grid"></div>
      <div class="absolute inset-0 noise-overlay"></div>

      <div class="relative z-10 max-w-4xl mx-auto px-6">
        <!-- Breadcrumb -->
        <nav class="reveal mb-8" aria-label="Fil d'Ariane">
          <ol class="flex items-center gap-2 font-mono text-sm tracking-wide" style="color: var(--text-muted);">
            <li><a href="/" class="hover:text-white transition-colors">Accueil</a></li>
            <li class="select-none" aria-hidden="true">&gt;</li>
            <li><a href="/#etapes" class="hover:text-white transition-colors">Les Étapes</a></li>
            <li class="select-none" aria-hidden="true">&gt;</li>
            <li style={`color: ${accent};`}>Étape Est</li>
          </ol>
        </nav>

        <div class="reveal delay-1 mb-4">
          <span
            class="inline-block font-mono text-xs tracking-widest uppercase px-3 py-1 rounded-full border"
            style={`color: ${accent}; border-color: ${accent}40; background: ${accent}10;`}
          >
            Format 2026 modifié
          </span>
        </div>

        <h1 class="reveal delay-2 font-display text-3xl md:text-4xl lg:text-5xl font-bold mb-6">
          L'étape Est n'est pas au programme 2026
        </h1>

        <p class="reveal delay-3 text-lg font-body leading-relaxed" style="color: var(--text-secondary);">
          Vous êtes arrivé ici avec un lien vers l'étape Est. Le format du Cyber Tour a évolué :
          l'édition 2026 se concentre sur <strong class="text-white font-semibold">trois étapes</strong>
          réparties sur quatre jours, du 20 au 23 octobre, afin de proposer des journées plus denses
          et des ateliers plus longs plutôt qu'un plus grand nombre de dates dispersées.
        </p>

        <p class="reveal delay-4 mt-4 text-lg font-body leading-relaxed" style="color: var(--text-secondary);">
          Les publics et les thématiques prévus pour l'Est ont été répartis sur les étapes ci-dessous.
        </p>
      </div>
    </section>

    <!-- ===== ÉTAPES EXISTANTES ===== -->
    <section class="py-16 px-6">
      <div class="max-w-5xl mx-auto">
        <h2 class="reveal font-display font-bold text-2xl sm:text-3xl mb-8">Les étapes du parcours 2026</h2>

        <ul class="reveal delay-1 grid sm:grid-cols-3 gap-6 list-none m-0 p-0">
          {stages.map((s) => (
            <li>
              <a
                href={s.href}
                class="h-full flex flex-col bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6 transition-colors hover:bg-white/[0.06]"
                aria-label={`Étape ${s.trackNumber} — ${s.direction}, ${s.dateShort}`}
              >
                <span
                  class="block rounded-full mb-4"
                  aria-hidden="true"
                  style={`width:32px;height:3px;background:${s.accentHex};`}
                ></span>
                <span class="font-mono text-[11px] tracking-widest uppercase mb-2" style={`color:${s.accentHex};`}>
                  Étape {s.trackNumber} · {s.direction}
                </span>
                <span class="font-display font-semibold text-lg text-white mb-2">{s.name}</span>
                <span class="text-white/50 text-sm font-body">{s.theme}</span>
                <span class="text-white/50 text-xs font-mono mt-3">{s.dateShort} · {s.lieu}</span>
              </a>
            </li>
          ))}
        </ul>

      </div>
    </section>

    <!-- ===== CONTACT ===== -->
    <section class="py-16 px-6" style="background: var(--bg-secondary);">
      <div class="max-w-3xl mx-auto text-center">
        <div class="reveal bg-white/[0.03] border border-white/[0.06] rounded-2xl p-10">
          <h2 class="font-display text-2xl md:text-3xl font-bold mb-4">
            Une question sur le changement de format ?
          </h2>
          <p class="font-body mb-8 max-w-lg mx-auto" style="color: var(--text-secondary);">
            Si vous portiez un projet, un atelier ou un partenariat pour l'étape Est,
            écrivez-nous : nous le replacerons sur l'étape la plus adaptée.
          </p>
          <a href="mailto:evenement@clusir-roi.org" class="btn-primary inline-flex items-center gap-3 rounded-xl">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Nous contacter
          </a>
          <div class="mt-8">
            <a href="/#etapes" class="font-mono text-sm tracking-wide text-white/50 hover:text-white transition-colors">
              &larr; Retour aux étapes
            </a>
          </div>
        </div>
      </div>
    </section>

  </div>

  <Footer />
</Layout>
