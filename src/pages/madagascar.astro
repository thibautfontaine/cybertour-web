---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MapMadagascar from '../components/MapMadagascar.astro';

const accent = "#2dd4bf"; // teal océan — accent de la leg Madagascar

const formats = [
  {
    title: 'Conférences',
    desc: "Souveraineté numérique régionale, sécurité maritime, résilience des câbles sous-marins et menaces sur la zone SWIO.",
    icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
  },
  {
    title: 'CTF',
    desc: "Capture The Flag inter-établissements — un vivier étudiant malgache et réunionnais qui s'affronte sur les mêmes épreuves.",
    icon: 'M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9',
  },
  {
    title: 'Ateliers de formation',
    desc: "Sessions pratiques : OSINT, gestion de crise, sécurité du code, sensibilisation — adaptées aux publics et aux structures locales.",
    icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.247m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.247',
  },
];

const maritimeTopics = [
  { title: 'Résilience des câbles sous-marins', desc: "METISS, LION, EASSy : l'épine dorsale numérique de la zone atterrit ici. Protéger ces câbles, c'est protéger la connectivité de l'océan Indien." },
  { title: 'Sûreté portuaire & ISPS', desc: "Toamasina, Port Réunion : les systèmes portuaires et logistiques comme surface d'attaque critique." },
  { title: 'Surveillance des espaces maritimes', desc: "Pêche illicite, trafic, données AIS : la cyber au service de la souveraineté sur les espaces océaniques." },
];

const pageTitle = "Étape Madagascar — Antananarivo | CyberTour Océan Indien 2026";
const pageDesc = "Étape internationale du CyberTour Océan Indien — Université d'Antananarivo, novembre 2026. Thème : Cybersecurity from Lands to Seas. Conférences, CTF et ateliers de formation.";
---

<Layout title={pageTitle} description={pageDesc}>
  <Navbar slot="navbar" currentPage="madagascar" />
  <Navbar currentPage="madagascar" />

  <div style={`--stage-accent: ${accent};`} class="pb-16">

    <!-- ===== HERO ===== -->
    <section class="relative min-h-[55vh] flex items-end overflow-hidden">
      <div
        class="absolute inset-0"
        style={`background: linear-gradient(135deg, #0f1a30 0%, ${accent}14 50%, #0f1a30 100%);`}
      ></div>
      <div class="absolute inset-0 cyber-grid"></div>
      <div class="absolute inset-0 noise-overlay"></div>

      <div class="relative z-10 w-full max-w-6xl mx-auto px-6 pb-14 pt-32">
        <!-- Breadcrumb -->
        <nav class="reveal mb-8" aria-label="Fil d'Ariane">
          <ol class="flex items-center gap-2 font-mono text-sm tracking-wide" style="color: var(--text-muted);">
            <li><a href="/" class="hover:text-white transition-colors">Accueil</a></li>
            <li class="select-none">&gt;</li>
            <li style={`color: ${accent};`}>Étape internationale · Madagascar</li>
          </ol>
        </nav>

        <!-- Badge -->
        <div class="reveal delay-1 mb-4 flex flex-wrap items-center gap-3">
          <span
            class="inline-block font-mono text-xs tracking-widest uppercase px-3 py-1 rounded-full border"
            style={`color: ${accent}; border-color: ${accent}40; background: ${accent}10;`}
          >
            Étape internationale · SWIO
          </span>
          <span class="inline-block font-mono text-xs tracking-widest uppercase px-3 py-1 rounded-full border border-white/15 bg-white/[0.04] text-white/55">
            Date en cours de fixation
          </span>
        </div>

        <!-- Title -->
        <h1 class="reveal delay-2 font-display text-4xl md:text-5xl lg:text-6xl font-bold mb-4">
          Étape Madagascar
        </h1>

        <!-- Theme subtitle -->
        <p class="reveal delay-3 font-display text-lg md:text-2xl italic" style={`color: ${accent};`}>
          « Cybersecurity from Lands to Seas »
        </p>

        <!-- Info bar -->
        <div class="reveal delay-4 flex flex-wrap items-center gap-4 mt-8">
          <div class="flex items-center gap-2 font-body text-base" style="color: var(--text-secondary);">
            <svg class="w-4 h-4 shrink-0" style={`color: ${accent};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span>Novembre 2026</span>
          </div>
          <span class="hidden sm:block w-px h-4 bg-white/20"></span>
          <div class="flex items-center gap-2 font-body text-base" style="color: var(--text-secondary);">
            <svg class="w-4 h-4 shrink-0" style={`color: ${accent};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Université d'Antananarivo</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== CARTE SVG ===== -->
    <MapMadagascar />

    <!-- ===== INTRO ===== -->
    <section class="py-12 px-6">
      <div class="max-w-3xl mx-auto reveal">
        <p class="text-lg md:text-xl text-white/70 leading-relaxed font-body">
          Le <strong class="text-white font-semibold">CyberTour</strong> franchit le canal du Mozambique.
          Après les étapes réunionnaises d'octobre, une <strong class="text-white font-semibold">étape internationale</strong>
          se pose sur les hautes terres malgaches, à l'<strong class="text-white font-semibold">Université d'Antananarivo</strong>.
          Une journée qui relie le cyber terrestre à la sûreté des mers — parce que dans l'océan Indien,
          la sécurité numérique et la sécurité maritime ne font qu'un.
        </p>
      </div>
    </section>

    <!-- ===== PROGRAMME ===== -->
    <section id="programme" class="py-16 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="reveal mb-12">
          <span class="font-mono text-sm tracking-widest uppercase" style={`color: ${accent}CC;`}>Programme</span>
          <h2 class="font-display font-bold text-3xl sm:text-4xl mt-4">Trois temps forts</h2>
          <p class="text-white/50 mt-4 text-lg font-body">Conférences, compétition et formation sur une même journée.</p>
        </div>

        <div class="reveal delay-1 grid sm:grid-cols-3 gap-6">
          {formats.map(item => (
            <div
              class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6 transition-colors"
              style="--tw-border-opacity:1;"
            >
              <div
                class="w-11 h-11 rounded-xl flex items-center justify-center mb-4"
                style={`background: ${accent}15;`}
              >
                <svg class="w-5 h-5" style={`color: ${accent};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                </svg>
              </div>
              <h3 class="font-display font-semibold text-lg mb-2">{item.title}</h3>
              <p class="text-white/50 text-sm font-body leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- ===== VOLET MARITIME ===== -->
    <section class="py-16 px-6" style="background: var(--bg-secondary);">
      <div class="max-w-5xl mx-auto">
        <div class="reveal mb-12">
          <span class="font-mono text-sm tracking-widest uppercase" style={`color: ${accent}CC;`}>// From Lands to Seas</span>
          <h2 class="font-display font-bold text-3xl sm:text-4xl mt-4">Le fil maritime</h2>
          <p class="text-white/50 mt-4 text-lg font-body max-w-2xl">
            Ce qui distingue cette étape : un volet dédié à la cybersécurité maritime, porté avec les acteurs
            régionaux de la mer.
          </p>
        </div>

        <div class="reveal delay-1 grid md:grid-cols-3 gap-6">
          {maritimeTopics.map(topic => (
            <div class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6">
              <h3 class="font-display font-semibold text-lg mb-2 text-white">{topic.title}</h3>
              <p class="text-white/50 text-sm font-body leading-relaxed">{topic.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== PARTENAIRES INSTITUTIONNELS ===== -->
    <section class="py-16 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="reveal mb-10">
          <span class="font-mono text-sm tracking-widest uppercase" style={`color: ${accent}CC;`}>Cadre régional</span>
          <h2 class="font-display font-bold text-2xl sm:text-3xl mt-4">Une étape portée à l'échelle de la zone</h2>
          <p class="text-white/50 mt-4 font-body max-w-2xl">
            Avec l'appui des institutions régionales de l'océan Indien et l'accueil de l'Université d'Antananarivo.
          </p>
        </div>

        <div class="reveal delay-1 grid grid-cols-2 sm:grid-cols-4 gap-4">
          {[
            { name: "Université d'Antananarivo", tag: 'Hôte', logo: '/assets/partners/univ-antananarivo.png' },
            { name: 'COI', tag: 'Commission de l’Océan Indien', logo: '/assets/partners/coi.png' },
            { name: 'CRFIM', tag: 'Centre régional de fusion d’information maritime', logo: '/assets/partners/crfim.png' },
            { name: 'CLUSIR Réunion Océan Indien', tag: 'Organisateur', logo: null },
          ].map(p => (
            <div class="bg-white/[0.03] border border-white/[0.06] rounded-xl p-5 text-center flex flex-col items-center justify-center min-h-[140px] gap-2">
              {p.logo && (
                <img
                  src={p.logo}
                  alt={`Logo ${p.name}`}
                  class="h-14 w-auto object-contain mb-1"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <span class="font-display font-semibold text-sm text-white/85 leading-tight">{p.name}</span>
              <span class="font-mono text-[10px] tracking-wide uppercase" style={`color: ${accent}AA;`}>{p.tag}</span>
            </div>
          ))}
        </div>

        <p class="reveal delay-2 text-white/40 text-xs font-mono mt-6 text-center">
          Soutiens et intervenants en cours de confirmation.
        </p>
      </div>
    </section>

    <!-- ===== INFOS PRATIQUES ===== -->
    <section class="py-16 px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="reveal font-display text-2xl md:text-3xl font-bold mb-10 text-center">Infos Pratiques</h2>
        <div class="reveal delay-1 bg-white/[0.03] border border-white/[0.06] rounded-2xl p-8">
          <div class="flex items-start gap-5">
            <div class="shrink-0 w-12 h-12 rounded-xl flex items-center justify-center" style={`background: ${accent}15;`}>
              <svg class="w-6 h-6" style={`color: ${accent};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <h3 class="font-display text-lg font-semibold mb-1">Lieu</h3>
              <p class="font-body" style="color: var(--text-secondary);">Université d'Antananarivo, Madagascar</p>
              <p class="font-mono text-xs mt-2" style="color: var(--text-muted);">Date de novembre 2026 — en cours de fixation</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== CONTACT / RETOUR ===== -->
    <section class="py-16 px-6" style="background: var(--bg-secondary);">
      <div class="max-w-3xl mx-auto text-center">
        <div class="reveal rounded-2xl p-10" style={`background: ${accent}0A; border: 1px solid ${accent}26;`}>
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl mb-6" style={`background: ${accent}1A;`}>
            <svg class="w-7 h-7" style={`color: ${accent};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h2 class="font-display text-2xl md:text-3xl font-bold mb-4">Intéressé pour participer ou intervenir ?</h2>
          <p class="font-body mb-8 max-w-lg mx-auto" style="color: var(--text-secondary);">
            Conférenciers, partenaires institutionnels, experts cyber maritime : contactez-nous pour rejoindre
            l'étape malgache du CyberTour Océan Indien.
          </p>
          <a href="mailto:evenement@clusir-roi.org" class="btn-primary inline-flex items-center gap-3 rounded-xl">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Nous contacter
          </a>
          <div class="mt-8">
            <a href="/#etapes" class="font-mono text-sm tracking-wide hover:text-white transition-colors" style={`color: ${accent}CC;`}>
              &larr; Retour aux étapes Réunion
            </a>
          </div>
        </div>
      </div>
    </section>

  </div>

  <Footer slot="footer" />
  <Footer />
</Layout>
