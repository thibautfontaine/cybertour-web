---
import StageLayout from '../layouts/StageLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { stages, ACCENT_TEXT } from '../data/stages';
const stage = stages.find(s => s.id === 'nord')!;
---

<StageLayout stage={stage}>
  <Navbar slot="navbar" currentPage="nord" />

  <section class="py-20">
    <div class="max-w-5xl mx-auto px-6">
      <div class="reveal mb-12">
        <span class="font-mono text-sm tracking-widest uppercase" style={`color: ${ACCENT_TEXT}CC;`}>Programme</span>
        <h2 class="font-display font-bold text-3xl sm:text-4xl mt-4">Matinée institutionnelle</h2>
        <p class="text-white/50 mt-4 text-lg">Mardi 20 Octobre — 8h-13h — Campus Moufia, Saint-Denis</p>
      </div>

      <!-- Format cards -->
      <div class="reveal delay-1 mt-10">
        <div class="grid sm:grid-cols-3 gap-6">
          {[
            { title: 'Ouverture officielle', desc: 'Discours de bienvenue des représentants institutionnels de La Réunion.' },
            { title: 'Interventions institutionnelles', desc: "Services de l'État, agences nationales et acteurs de la cybersécurité dans les Outre-mer." },
            { title: 'Présentation du CyberTour', desc: 'Présentation du parcours CyberTour 2026 et des 3 étapes par le CLUSIR ROI.' },
          ].map(item => (
            <div class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6 hover:border-gold/20 transition-colors">
              <h3 class="font-display font-semibold text-lg mb-2">{item.title}</h3>
              <p class="text-white/50 text-sm font-body">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Programme à venir -->
      <div class="reveal delay-2 mt-10">
        <div class="bg-gold/[0.06] border border-gold/[0.15] rounded-xl p-6 flex items-start gap-4">
          <div class="shrink-0 w-10 h-10 rounded-lg bg-gold/10 flex items-center justify-center">
            <svg class="w-5 h-5 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <h4 class="font-display font-semibold text-sm mb-1 text-gold">Programme complet</h4>
            <p class="text-white/50 text-sm font-body">
              Le programme détaillé et la liste des intervenants seront publiés à l'approche de l'événement.
            </p>
          </div>
        </div>
      </div>

      <!-- Co-organisateurs -->
      <div class="reveal delay-3 mt-16">
        <h3 class="font-display font-semibold text-xl mb-8">Co-organisateurs</h3>
        <div class="flex flex-wrap items-center justify-center gap-8">
          <div class="partner-bubble px-6 py-3">
            <img src="/assets/logo-univ-reunion.png" alt="Université de La Réunion" class="h-16 sm:h-20 w-auto object-contain" loading="lazy" />
          </div>
          <div class="partner-bubble px-6 py-3">
            <img src="/assets/logo-clusir.png" alt="CLUSIR Réunion Océan Indien" class="h-16 sm:h-20 w-auto object-contain" loading="lazy" />
          </div>
        </div>
      </div>

      <!-- Acteurs institutionnels -->
      <div class="reveal delay-4 mt-16">
        <h3 class="font-display font-semibold text-xl mb-8">Acteurs institutionnels attendus</h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
          {['Région Réunion', 'Département', 'Préfecture', 'Rectorat', 'ANSSI', 'Viginum', 'DINUM', 'SGDSN', 'Renater', 'OFAC', 'Cyber Reunion'].map(name => (
            <div class="bg-white/[0.03] border border-white/[0.06] rounded-xl p-4 text-center hover:border-gold/20 transition-colors">
              <span class="font-display font-semibold text-sm text-white/70">{name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</StageLayout>
