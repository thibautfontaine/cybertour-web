---
/**
 * Vue partagée de l'étape EDN (FR `/edn`, EN `/en/edn`).
 * Toute chaîne visible vient de `src/i18n/edn.ts`.
 */
import StageLayout from '../layouts/StageLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getStage, ACCENT_PAINT } from '../data/stages';
import { getLang } from '../i18n';
import { edn, EDN_REGISTRATION, EDN_EMAIL, EDN_PHONE } from '../i18n/edn';
import ProgrammeTimeline from '../components/ProgrammeTimeline.astro';

const lang = getLang(Astro.currentLocale);
const t = edn[lang];
const stage = getStage(lang, 'edn');
---

<StageLayout stage={stage}>
  <Navbar slot="navbar" currentPage="edn" />

  <!-- Programme section -->
  <section class="py-20">
    <div class="max-w-5xl mx-auto px-6">
      <div class="reveal">
        <span class="font-mono text-cyan-400/60 text-sm tracking-widest uppercase">{t.programmeLabel}</span>
        <h2 class="font-display font-bold text-3xl sm:text-4xl mt-4">{t.programmeTitle}</h2>
        <p class="font-body mt-6 max-w-3xl" style="color: var(--text-secondary);">{t.programmeIntro}</p>
      </div>

      <!-- Programme de l'après-midi -->
      <div class="reveal delay-1 mt-12">
        <h3 class="font-display font-semibold text-2xl mb-6">{t.scheduleTitle}</h3>
        <ProgrammeTimeline sessions={t.programme} accent="cyan" />
      </div>
    </div>
  </section>

  <!-- Inscription : formulaire de l'EDN, l'étape n'est pas sur la billetterie
       Weezevent du CLUSIR (StageLayout masque son encart pour les hôtes). -->
  <section class="py-20 px-6" style="background: var(--bg-secondary);">
    <div class="max-w-3xl mx-auto text-center">
      <div class="reveal bg-white/[0.03] border border-white/[0.06] rounded-2xl p-12">
        <div
          class="inline-flex items-center justify-center w-16 h-16 rounded-2xl mb-6"
          style={`background: ${ACCENT_PAINT}15;`}
        >
          <svg class="w-8 h-8" style={`color: ${ACCENT_PAINT};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
          </svg>
        </div>

        <h2 class="font-display text-2xl md:text-3xl font-bold mb-4">
          {t.registrationTitle}
        </h2>

        <p class="font-body mb-8 max-w-lg mx-auto" style="color: var(--text-secondary);">
          {t.registrationText}
        </p>

        <a
          href={EDN_REGISTRATION}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary inline-flex items-center gap-3 rounded-xl"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
          </svg>
          {t.registrationCta}
        </a>

        <p class="mt-4 font-mono text-xs tracking-wide" style="color: var(--text-muted);">
          {t.registrationContactHint}
          <a href={`mailto:${EDN_EMAIL}`} class="hover:text-white transition-colors underline underline-offset-2">{EDN_EMAIL}</a>
          ·
          <a href={`tel:+262${EDN_PHONE.replace(/\s/g, '').slice(1)}`} class="hover:text-white transition-colors underline underline-offset-2">{EDN_PHONE}</a>
        </p>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</StageLayout>
