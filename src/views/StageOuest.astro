---
/**
 * Vue partagée de l'étape Ouest (FR `/ouest`, EN `/en/ouest`).
 * Toute chaîne visible vient de `src/i18n/ouest.ts`.
 */
import StageLayout from '../layouts/StageLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getStage } from '../data/stages';
import { getLang } from '../i18n';
import { ouest } from '../i18n/ouest';
import ProgrammeTimeline from '../components/ProgrammeTimeline.astro';
import PartnerLogo from '../components/PartnerLogo.astro';
import { getPartners } from '../data/partners';

const lang = getLang(Astro.currentLocale);
const t = ouest[lang];
const stage = getStage(lang, 'ouest');

const organisers = getPartners(['clusir', 'office-eau']);
const stagePartners = getPartners(['orange-cyberdefense', 'sfr-business', 'youtell', 'cf-cyber']);
---

<StageLayout stage={stage}>
  <Navbar slot="navbar" currentPage="ouest" />

  <!-- Programme section -->
  <section class="py-20">
    <div class="max-w-5xl mx-auto px-6">
      <div class="reveal">
        <span class="font-mono text-cyan-400/60 text-sm tracking-widest uppercase">{t.programmeLabel}</span>
        <h2 class="font-display font-bold text-3xl sm:text-4xl mt-4">{t.programmeTitle}</h2>
      </div>

      <!-- Objectif et format de la journée -->
      <div class="reveal delay-1 mt-8 bg-cyan-400/[0.06] border border-cyan-400/[0.15] rounded-xl p-6 flex items-start gap-4">
        <div class="shrink-0 w-10 h-10 rounded-lg bg-cyan-400/10 flex items-center justify-center">
          <svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1" />
          </svg>
        </div>
        <div>
          <h3 class="font-display font-semibold text-sm mb-1 text-cyan-400">{t.objectiveLabel}</h3>
          <p class="text-white text-lg leading-relaxed">{t.objective}</p>
          <p class="text-white/60 text-sm mt-3 leading-relaxed">{t.format}</p>
        </div>
      </div>

      <!-- Programme de la journée -->
      <div class="reveal delay-2 mt-12">
        <h3 class="font-display font-semibold text-2xl mb-6">{t.scheduleTitle}</h3>
        <ProgrammeTimeline sessions={t.programme} accent="cyan" />
      </div>

      <!-- Organisateurs et partenaires de l'étape -->
      <div class="reveal mt-16 space-y-14">
        <div>
          <h3 class="font-display font-semibold text-xl mb-8">{t.organisersTitle}</h3>
          <div class="flex flex-wrap items-center justify-center gap-8">
            {organisers.map((p) => <PartnerLogo partner={p} size={p.size.stage} />)}
          </div>
        </div>
        <div>
          <h3 class="font-display font-semibold text-xl mb-8">{t.stagePartnersTitle}</h3>
          <div class="flex flex-wrap items-center justify-center gap-6">
            {stagePartners.map((p) => <PartnerLogo partner={p} size={p.size.stage} pad="px-5 py-3" />)}
          </div>
        </div>
      </div>

    </div>
  </section>

  <Footer slot="footer" />
</StageLayout>
