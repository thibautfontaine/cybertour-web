---
import { getLang, localizePath } from '../i18n';

/* L'étape Est (Epitech, Saint-André, 29 octobre 2026) est annulée et retirée
   du site le 28/10/2026. L'URL a circulé : elle reste une redirection vers le
   parcours, dans chaque langue (/est et /en/est), en noindex. */
const lang = getLang(Astro.currentLocale);
const target = localizePath('/#etapes', lang);

const text = {
  fr: {
    title: "L'étape Est du CyberTour 2026",
    body: "L'étape Est 2026, prévue chez Epitech à Saint-André le jeudi 29 octobre, est annulée.",
    link: 'Voir le parcours',
  },
  en: {
    title: 'CyberTour 2026 — East stage',
    body: 'The 2026 East stage, planned at Epitech in Saint-André on Thursday 29 October, is cancelled.',
    link: 'See the route',
  },
}[lang];
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{text.title}</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={`https://cybertour.re${target}`} />
    <meta name="robots" content="noindex, follow" />
  </head>
  <body>
    <p>
      {text.body} <a href={target}>{text.link}</a>.
    </p>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </body>
</html>
