---
/**
 * Page d'accueil, vue partagée par `/` (fr) et `/en/` (en).
 *
 * Aucune chaîne visible n'est écrite ici : tout vient de `src/i18n/home.ts`.
 * Ce fichier ne porte plus que la structure, les classes Tailwind et les
 * tracés SVG — les seuls littéraux qui restent sont des noms propres de
 * marque (« CYBER », « TOUR », « REUNION »), des adresses et des identifiants
 * techniques (ids d'ancre, chemins d'assets, UID du .ics).
 */
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MapReunion from '../components/MapReunion.astro';
import TimelineParcours from '../components/TimelineParcours.astro';
import StageCard from '../components/StageCard.astro';
import PartnerPyramid from '../components/PartnerPyramid.astro';
import SponsorsFloating from '../components/SponsorsFloating.astro';
import { getStages } from '../data/stages';
import { WEEZEVENT_PAGE } from '../data/ticketing';
import { getLang, localizePath } from '../i18n';
import { home } from '../i18n/home';

const lang = getLang(Astro.currentLocale);
const t = home[lang];
const p = (path: string) => localizePath(path, lang);

const stages = getStages(lang);

---

<Layout title={t.metaTitle} description={t.metaDescription}>

  <!-- ===== NAVBAR ===== -->
  <Navbar />

  <!-- ===== HERO ===== -->
  <section id="main-content" class="relative min-h-dvh flex items-center justify-center overflow-hidden pt-24 pb-24 sm:pb-20">
    <!-- Background image with overlay -->
    <div class="absolute inset-0">
      <img src="/assets/hero-bg.jpg" alt="" width="1920" height="1080" class="w-full h-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-b from-navy-dark/80 via-navy-dark/70 to-navy-dark"></div>
    </div>

    <!-- Grid overlay -->
    <div class="absolute inset-0 cyber-grid"></div>

    <!-- Scan line effect -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="absolute left-0 right-0 h-px bg-gold/20 animate-scan"></div>
    </div>

    <!-- Glow orbs -->
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-navy rounded-full animate-pulse-glow"></div>
    <div class="absolute bottom-1/4 right-1/4 w-64 h-64 bg-gold/20 rounded-full animate-pulse-glow" style="animation-delay: 2s;"></div>

    <!-- Floating island silhouette -->
    <div class="absolute right-0 bottom-0 w-[500px] h-[500px] opacity-[0.06] animate-float pointer-events-none">
      <img src="/assets/reunion-silhouette.png" alt="" class="w-full h-full object-contain" />
    </div>

    <!-- Hero content -->
    <div class="relative z-10 text-center px-6 max-w-5xl mx-auto">
      <!-- Event badge -->
      <div class="inline-flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-5 py-2 mb-5" style="animation: slide-up 0.8s ease-out both;">
        <span class="w-2 h-2 bg-gold rounded-full animate-pulse"></span>
        <span class="text-sm font-mono text-white/60 tracking-widest uppercase">{t.heroBadge}</span>
      </div>

      <!-- Main title -->
      <h1 class="font-display font-extrabold leading-[0.95] mb-5" style="animation: slide-up 0.8s ease-out 0.15s both;">
        <span class="glitch-wrapper block">
          <span class="glitch text-6xl sm:text-7xl md:text-8xl 2xl:text-9xl tracking-tight text-white" data-text="CYBER">CYBER</span>
        </span>
        <span class="block text-6xl sm:text-7xl md:text-8xl 2xl:text-9xl tracking-tight">
          <span class="text-gold">TOUR</span>
          <span class="text-white/20 ml-2 md:ml-4" aria-hidden="true">&#47;&#47;</span>
        </span>
        <span class="block text-3xl sm:text-4xl md:text-5xl tracking-[0.2em] mt-4 reunion-outline">REUNION</span>
      </h1>

      <!-- Présentation en une phrase : lue juste après le titre, et premier
           texte descriptif de la page pour les moteurs de recherche. -->
      <p class="max-w-2xl mx-auto mb-7 text-base sm:text-lg text-white/70 leading-relaxed" style="animation: slide-up 0.8s ease-out 0.25s both;">
        {t.heroTagline}
      </p>

      <!-- Date & location -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-8 mb-8" style="animation: slide-up 0.8s ease-out 0.3s both;">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <span class="font-display font-semibold text-lg tracking-wide">{t.heroDates}</span>
        </div>
        <span class="hidden sm:block w-1 h-1 bg-gold rounded-full"></span>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span class="font-display font-semibold text-lg tracking-wide">{t.heroPlaces}</span>
        </div>
      </div>

      <!-- CTA buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4" style="animation: slide-up 0.8s ease-out 0.45s both;">
        <a href={p('/#inscription')} class="btn-primary rounded-lg font-display">{t.heroCtaRegister}</a>
        <a href={p('/#etapes')} class="btn-outline rounded-lg font-display text-sm">{t.heroCtaRoute}</a>
      </div>

      <!-- Context pills — qualification rapide pour le visiteur -->
      <div class="flex flex-wrap items-center justify-center gap-3 mt-6" style="animation: slide-up 0.8s ease-out 0.55s both;">
        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-mono tracking-wider border border-emerald-400/25 bg-emerald-400/[0.07] text-emerald-400">
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 13l4 4L19 7"/></svg>
          {t.heroPillFree}
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-mono tracking-wider border border-gold/25 bg-gold/[0.07] text-gold">
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          {t.heroPillSeats}
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-mono tracking-wider border border-white/15 bg-white/[0.05] text-white/60">
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
          {t.heroPillHybrid}
        </span>
      </div>

      <!-- Countdown -->
      <div id="countdown" class="mt-10 flex items-center justify-center gap-6 sm:gap-10" style="animation: slide-up 0.8s ease-out 0.6s both;">
        <div class="text-center">
          <span id="cd-days" class="block font-mono text-3xl sm:text-4xl font-bold text-gold tabular-nums">---</span>
          <span class="text-xs text-white/55 uppercase tracking-widest">{t.cdDays}</span>
        </div>
        <span class="text-white/20 text-2xl font-light" aria-hidden="true">:</span>
        <div class="text-center">
          <span id="cd-hours" class="block font-mono text-3xl sm:text-4xl font-bold text-white tabular-nums">--</span>
          <span class="text-xs text-white/55 uppercase tracking-widest">{t.cdHours}</span>
        </div>
        <span class="text-white/20 text-2xl font-light" aria-hidden="true">:</span>
        <div class="text-center">
          <span id="cd-mins" class="block font-mono text-3xl sm:text-4xl font-bold text-white tabular-nums">--</span>
          <span class="text-xs text-white/55 uppercase tracking-widest">{t.cdMins}</span>
        </div>
        <span class="text-white/20 text-2xl font-light" aria-hidden="true">:</span>
        <div class="text-center">
          <span id="cd-secs" class="block font-mono text-3xl sm:text-4xl font-bold text-white/50 tabular-nums">--</span>
          <span class="text-xs text-white/55 uppercase tracking-widest">{t.cdSecs}</span>
        </div>
      </div>
    </div>

    {/* Sous sm, la barre des partenaires Gold occupe le bas du hero :
        l'indicateur de défilement lui laisse la place. */}
    <div class="hidden sm:flex absolute bottom-8 left-1/2 -translate-x-1/2 flex-col items-center gap-2 text-white/50">
      <span class="text-xs tracking-widest uppercase">{t.scroll}</span>
      <div class="w-px h-8 bg-gradient-to-b from-white/30 to-transparent"></div>
    </div>
  </section>

  <!-- ===== CARTE DU TOUR / ÉTAPES ===== -->
  <section id="etapes" class="relative py-32 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-deep to-navy-dark"></div>
    <div class="absolute inset-0 cyber-grid opacity-50"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6">
      <div class="reveal mb-16 text-center">
        <span class="section-label">{t.routeLabel}</span>
        <h2 class="section-title mt-4" set:html={t.routeTitleHtml}></h2>
        <p class="text-white/50 mt-4 max-w-2xl mx-auto text-lg">
          {t.routeIntro}
        </p>
        <!-- C4 — Dates bien visibles -->
        <div class="inline-flex items-center gap-2 mt-6 px-4 py-2 rounded-full border border-gold/20 bg-gold/[0.06]">
          <svg class="w-4 h-4 text-gold/70 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <span class="font-mono text-sm text-gold/80 font-bold tracking-wider">{t.routeDates}</span>
        </div>
      </div>

      {/* La frise possède le quand, la carte le où. Les deux côte à côte, la
          frise en vedette — c'est la chronologie qui structure, pas la
          géographie (décisions D4 et D6). */}
      <div class="reveal grid lg:grid-cols-[1.6fr_1fr] gap-10 lg:gap-14 items-center">
        <TimelineParcours />
        <MapReunion />
      </div>

      <!-- Stage cards bento grid -->
      <div class="grid md:grid-cols-2 gap-6 mt-16">
        {stages.map(stage => <StageCard stage={stage} />)}
      </div>
    </div>
  </section>

  <!-- ===== INSCRIPTION ===== -->
  <section id="inscription" class="relative py-32 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-navy-dark via-slate-deep to-navy-dark"></div>
    <div class="absolute inset-0 cyber-grid opacity-30"></div>

    <div class="relative z-10 max-w-4xl mx-auto px-6">
      <div class="reveal mb-14 text-center">
        <span class="section-label">{t.regLabel}</span>
        <h2 class="section-title mt-4" set:html={t.regTitleHtml}></h2>
        <p class="text-white/50 mt-4 max-w-2xl mx-auto text-lg">
          {t.regIntro}
        </p>
      </div>

      {/* Billetterie Weezevent — simple visuel cliquable vers la page
          publique my.weezevent.com/cybertour (nouvel onglet). Aucun module
          tiers chargé sur le site. */}
      <div class="reveal delay-1 mx-auto max-w-3xl">
        <a
          href={WEEZEVENT_PAGE}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t.regImageLinkLabel}
          class="group block overflow-hidden rounded-2xl border border-white/10 shadow-2xl shadow-navy/50 transition-all hover:border-gold/50 hover:shadow-gold/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold"
        >
          <img
            src="/assets/og-cybertour-2026.png"
            alt={t.regImageAlt}
            width="1200"
            height="630"
            loading="lazy"
            class="block w-full h-auto transition-transform duration-500 group-hover:scale-[1.02]"
          />
        </a>
      </div>

      <!-- Terminal — état réel de la billetterie + actions utiles -->
      <div class="reveal delay-2 mx-auto max-w-2xl mt-10">
        <div class="terminal-window bg-black/70 backdrop-blur-md border border-gold/20 rounded-xl px-6 py-6 sm:px-8 font-mono text-sm">
          <div class="flex items-center gap-2 mb-4 pb-3 border-b border-white/10">
            <span class="w-3 h-3 rounded-full bg-red/80" aria-hidden="true"></span>
            <span class="w-3 h-3 rounded-full bg-gold/60" aria-hidden="true"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-400/60" aria-hidden="true"></span>
            <span class="ml-3 text-white/50 text-xs">{t.regTermFile}</span>
          </div>

          <div class="space-y-2">
            <p class="text-emerald-400/80"><span class="text-gold/80">$</span> {t.regTermCmd}</p>
            <p class="text-white/70">
              {t.regEventLabel} <span class="text-gold">{t.regEventValue}</span> {t.regEventSuffix}
            </p>
            <p class="text-white/70">
              {t.regTicketLabel} <span class="text-gold">{t.regTicketDate}</span>
            </p>
            <p class="text-white/60">
              {t.regHint}
            </p>
          </div>

          <!-- Actions -->
          <div class="mt-6 flex flex-col sm:flex-row gap-3">
            <a
              href={WEEZEVENT_PAGE}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-[44px] flex-1 items-center justify-center gap-2 rounded-lg border border-gold/40 bg-gold/10 px-4 py-3 font-display text-sm font-semibold text-gold transition-colors hover:bg-gold/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold"
            >
              <svg class="w-4 h-4 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 5H7a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-3m-6-8h6m0 0v6m0-6L9 15" />
              </svg>
              {t.regOpenCta}
            </a>
            <button
              type="button"
              id="add-to-calendar"
              data-summary={t.icsSummary}
              data-description={t.icsDescription}
              data-location={t.icsLocation}
              data-done={t.icsDone}
              class="inline-flex min-h-[44px] flex-1 items-center justify-center gap-2 rounded-lg border border-white/20 bg-white/[0.06] px-4 py-3 font-display text-sm font-semibold text-white transition-colors hover:bg-white/[0.12] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold"
            >
              <svg class="w-4 h-4 shrink-0" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M12 14v4M10 16h4"/>
              </svg>
              {t.regCalendarCta}
            </button>
          </div>

          <p id="calendar-status" role="status" class="mt-3 text-xs text-white/50">
            {t.regCalendarStatus}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PARTENAIRES (Pyramid) ===== -->
  <section id="partenaires" class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-navy-dark via-slate-deep to-navy-dark"></div>
    <div class="relative z-10">
      <div class="reveal mb-12 text-center px-6">
        <span class="section-label">{t.partnersLabel}</span>
        <h2 class="section-title mt-4" set:html={t.partnersTitleHtml}></h2>
        <p class="text-white/50 mt-4 max-w-2xl mx-auto text-lg">
          {t.partnersIntro}
        </p>
      </div>
      <PartnerPyramid />
      <div class="reveal text-center pb-24 px-6">
        <a href={p('/partenaires')} class="btn-outline inline-flex items-center gap-2 rounded-lg font-display text-sm">
          {t.partnersCta}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== CTF CYBERMOIS ===== -->
  <!-- Version courte tant que le détail du CTF (dates, inscription) n'est pas
       connu : un titre, deux phrases, les partenaires. -->
  <section id="ctf" class="relative py-20 overflow-hidden">
    <div class="absolute inset-0 noise-overlay"></div>

    <div class="relative z-10 max-w-3xl mx-auto px-6">
      <div class="reveal relative bg-white/[0.03] border border-white/[0.06] rounded-2xl p-8 sm:p-10 overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-bl from-gold/5 to-transparent" aria-hidden="true"></div>

        <span class="section-label">{t.ctfLabel}</span>
        <h2 class="font-display font-bold text-3xl sm:text-4xl mt-4" set:html={t.ctfTitleHtml}></h2>

        <div class="flex flex-wrap items-center gap-3 mt-5">
          <span class="inline-flex items-center gap-1.5 bg-gold/10 border border-gold/20 rounded-full px-3 py-1 text-xs font-mono text-gold tracking-wider uppercase">
            <span class="w-1.5 h-1.5 bg-gold rounded-full animate-pulse"></span>
            {t.ctfBadgeMonth}
          </span>
          <span class="inline-flex items-center gap-1.5 bg-white/5 border border-white/10 rounded-full px-3 py-1 text-xs font-mono text-white/60 tracking-wider uppercase">
            {t.ctfBadgeAllMonth}
          </span>
        </div>

        <p class="text-white/70 leading-relaxed mt-5" set:html={t.ctfIntroHtml}></p>
        <p class="text-white/60 leading-relaxed mt-3" set:html={t.ctfBodyHtml}></p>

        <div class="flex flex-wrap items-center gap-4 mt-6">
          <span class="text-xs text-white/50 font-mono tracking-wider">{t.ctfPartnersLabel}</span>
          <a href="https://sec-dojo.com/fr" target="_blank" rel="noopener noreferrer" class="partner-bubble px-4 py-2" aria-label="SecDojo">
            <img src="/assets/logo-secdojo.png" alt="SecDojo" class="h-7 w-auto object-contain" loading="lazy" />
          </a>
          <a href="https://www.linkedin.com/company/cyber-reunion/" target="_blank" rel="noopener noreferrer" class="partner-bubble px-4 py-2" aria-label="Cyber Reunion">
            <img src="/assets/logo-cyber-reunion.jpg" alt="Cyber Reunion" class="h-7 w-auto object-contain" loading="lazy" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FOOTER ===== -->
  <Footer />

  <script>
    // ── « Ajouter à mon agenda » — génération d'un .ics côté client.
    //    Aucune dépendance : Blob + lien de téléchargement éphémère.
    //    Dates issues du JSON-LD de Layout.astro (fuseau Indien/Réunion, UTC+4)
    //    converties en UTC, conformément à la RFC 5545.
    //
    //    Ce script est bundlé : il ne voit pas le dictionnaire i18n. Les
    //    chaînes localisées (SUMMARY, DESCRIPTION, LOCATION, message de fin)
    //    lui sont passées par les attributs data du bouton.
    const calendarBtn = document.getElementById('add-to-calendar');
    const calendarStatus = document.getElementById('calendar-status');

    if (calendarBtn) {
      // Repli le champ sur 75 octets max, comme l'exige la RFC 5545 §3.1.
      function foldIcsLine(line) {
        const bytes = new TextEncoder().encode(line);
        if (bytes.length <= 75) return line;
        const out = [];
        let current = '';
        let currentBytes = 0;
        let limit = 75;
        for (const char of line) {
          const size = new TextEncoder().encode(char).length;
          if (currentBytes + size > limit) {
            out.push(current);
            current = ' ' + char;
            currentBytes = 1 + size;
            limit = 75;
          } else {
            current += char;
            currentBytes += size;
          }
        }
        out.push(current);
        return out.join('\r\n');
      }

      function toIcsDate(date) {
        return date.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
      }

      function escapeIcsText(text) {
        return text
          .replace(/\\/g, '\\\\')
          .replace(/;/g, '\\;')
          .replace(/,/g, '\\,')
          .replace(/\n/g, '\\n');
      }

      calendarBtn.addEventListener('click', () => {
        const summary = calendarBtn.dataset.summary || '';
        const description = calendarBtn.dataset.description || '';
        const location = calendarBtn.dataset.location || '';

        const lines = [
          'BEGIN:VCALENDAR',
          'VERSION:2.0',
          'PRODID:-//CLUSIR Reunion Ocean Indien//Cyber Tour Reunion 2026//FR',
          'CALSCALE:GREGORIAN',
          'METHOD:PUBLISH',
          'BEGIN:VEVENT',
          'UID:cyber-tour-reunion-2026@cybertour.re',
          'DTSTAMP:' + toIcsDate(new Date()),
          'DTSTART:' + toIcsDate(new Date('2026-10-20T08:00:00+04:00')),
          'DTEND:' + toIcsDate(new Date('2026-10-23T18:00:00+04:00')),
          'SUMMARY:' + escapeIcsText(summary),
          'DESCRIPTION:' + escapeIcsText(description),
          'LOCATION:' + escapeIcsText(location),
          'URL:https://cybertour.re/',
          'END:VEVENT',
          'END:VCALENDAR',
        ];

        const ics = lines.map(foldIcsLine).join('\r\n') + '\r\n';
        const blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = 'cyber-tour-reunion-2026.ics';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);

        // Un blob: n'a pas d'extension : l'option fileDownloads de Plausible
        // ne le voit pas, on déclare l'événement à la main.
        const plausible = window.plausible;
        if (typeof plausible === 'function') {
          plausible('Agenda ics', { props: { fichier: 'cyber-tour-reunion-2026.ics' } });
        }

        if (calendarStatus) {
          calendarStatus.textContent = calendarBtn.dataset.done || '';
        }
      });
    }
  </script>


  <SponsorsFloating />
</Layout>
