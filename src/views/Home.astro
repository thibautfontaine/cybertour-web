---
/**
 * Page d'accueil, vue partagée par `/` (fr) et `/en/` (en).
 *
 * Aucune chaîne visible n'est écrite ici : tout vient de `src/i18n/home.ts`.
 * Ce fichier ne porte plus que la structure, les classes Tailwind et les
 * tracés SVG — les seuls littéraux qui restent sont des noms propres de
 * marque (« CYBER », « TOUR », « REUNION »), des adresses et des identifiants
 * techniques (ids d'ancre, chemins d'assets).
 */
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MapReunion from '../components/MapReunion.astro';
import TimelineParcours from '../components/TimelineParcours.astro';
import StageCard from '../components/StageCard.astro';
import PartnerPyramid from '../components/PartnerPyramid.astro';
import SponsorsFloating from '../components/SponsorsFloating.astro';
import { getStages } from '../data/stages';
import { REPLAY_2026_URL } from '../data/bilan';
import { getLang, localizePath } from '../i18n';
import { home } from '../i18n/home';

const lang = getLang(Astro.currentLocale);
const t = home[lang];
const p = (path: string) => localizePath(path, lang);

const stages = getStages(lang);
const statFormat = new Intl.NumberFormat(lang === 'fr' ? 'fr-FR' : 'en-GB');

---

<Layout title={t.metaTitle} description={t.metaDescription}>

  <!-- ===== NAVBAR ===== -->
  <Navbar darkHero />

  <main>
  <!-- ===== HERO ===== -->
  <!-- Ouverture toujours sombre, comme une affiche, quel que soit le thème. -->
  <section id="main-content" class="theme-dark relative min-h-dvh flex items-center justify-center overflow-hidden pt-24 pb-24 sm:pb-20">
    <!-- Background image with overlay -->
    <div class="absolute inset-0">
      <img src="/assets/hero-bg.jpg" alt="" width="1920" height="1080" class="w-full h-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-b from-surface/80 via-surface/70 to-surface"></div>
    </div>

    <!-- Grid overlay -->
    <div class="absolute inset-0 cyber-grid"></div>

    <!-- Scan line effect -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="absolute left-0 right-0 h-px bg-gold/20 animate-scan"></div>
    </div>

    <!-- Glow orbs -->
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-navy rounded-full animate-pulse-glow light:opacity-25"></div>
    <div class="absolute bottom-1/4 right-1/4 w-64 h-64 bg-gold/20 rounded-full animate-pulse-glow" style="animation-delay: 2s;"></div>

    <!-- Floating island silhouette -->
    <div class="absolute right-0 bottom-0 w-[500px] h-[500px] opacity-[0.06] animate-float pointer-events-none">
      <img src="/assets/reunion-silhouette.png" alt="" width="500" height="500" class="w-full h-full object-contain" />
    </div>

    <!-- Hero content -->
    <div class="relative z-10 text-center px-6 max-w-5xl mx-auto">
      <!-- Event badge -->
      <div class="inline-flex items-center gap-2 bg-ink/5 border border-ink/10 rounded-full px-5 py-2 mb-5" style="animation: slide-up 0.8s ease-out both;">
        <span class="w-2 h-2 bg-gold rounded-full"></span>
        <span class="text-sm font-mono text-ink/70 tracking-widest uppercase">{t.heroBadge}</span>
      </div>

      <!-- Main title -->
      <h1 class="font-display font-extrabold leading-[0.95] mb-5" style="animation: slide-up 0.8s ease-out 0.15s both;">
        <span class="glitch-wrapper block">
          <span class="glitch text-6xl sm:text-7xl md:text-8xl 2xl:text-9xl tracking-tight text-ink" data-text="CYBER">CYBER</span>
        </span>
        <span class="block text-6xl sm:text-7xl md:text-8xl 2xl:text-9xl tracking-tight">
          <span class="text-accent">TOUR</span>
          <span class="text-ink/20 ml-2 md:ml-4" aria-hidden="true">&#47;&#47;</span>
        </span>
        <span class="block text-3xl sm:text-4xl md:text-5xl tracking-[0.2em] mt-4 reunion-outline">REUNION</span>
      </h1>

      <!-- Présentation en une phrase : lue juste après le titre, et premier
           texte descriptif de la page pour les moteurs de recherche. -->
      <p class="max-w-2xl mx-auto mb-7 text-base sm:text-lg text-ink/70 leading-relaxed" style="animation: slide-up 0.8s ease-out 0.25s both;">
        {t.heroTagline}
      </p>

      <!-- Date & location -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-8 mb-8" style="animation: slide-up 0.8s ease-out 0.3s both;">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <span class="font-display font-semibold text-lg tracking-wide">{t.heroDates}</span>
        </div>
        <span class="hidden sm:block w-1 h-1 bg-gold rounded-full"></span>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span class="font-display font-semibold text-lg tracking-wide">{t.heroPlaces}</span>
        </div>
      </div>

      <!-- CTA buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4" style="animation: slide-up 0.8s ease-out 0.4s both;">
        <a href={p('/bilan')} class="btn-primary rounded-lg font-display">{t.heroCtaBilan}</a>
        <a href={REPLAY_2026_URL} target="_blank" rel="noopener" class="btn-outline inline-flex items-center gap-2 rounded-lg font-display text-sm">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
          {t.heroCtaReplay}
        </a>
      </div>

      <!-- L'ancien compte à rebours devient le décompte de l'édition. Les valeurs
           finales sont dans le HTML : sans JavaScript, ou avec le mouvement
           réduit, elles s'affichent directement. -->
      <dl class="grid grid-cols-3 gap-4 sm:gap-10 max-w-xl mx-auto mt-9" style="animation: slide-up 0.8s ease-out 0.5s both;">
        {t.heroStats.map(stat => (
          <div class="flex flex-col-reverse items-center gap-1 text-center">
            <dt class="text-xs sm:text-sm text-ink/70 leading-snug">{stat.label}</dt>
            <dd class="font-mono text-3xl sm:text-4xl font-bold text-accent tabular-nums" data-count={stat.count} data-suffix={stat.suffix}>{statFormat.format(stat.count)}{stat.suffix}</dd>
          </div>
        ))}
      </dl>
    </div>

    {/* Sous sm, la barre des partenaires Gold occupe le bas du hero :
        l'indicateur de défilement lui laisse la place. */}
    <div class="hidden sm:flex absolute bottom-8 left-1/2 -translate-x-1/2 flex-col items-center gap-2 text-ink/50">
      <span class="text-xs tracking-widest uppercase">{t.scroll}</span>
      <div class="w-px h-8 bg-gradient-to-b from-ink/30 to-transparent"></div>
    </div>
  </section>

  <!-- ===== CARTE DU TOUR / ÉTAPES ===== -->
  <section id="etapes" class="relative py-32 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-surface-2 to-surface"></div>
    <div class="absolute inset-0 cyber-grid opacity-50"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6">
      <div class="reveal mb-16 text-center">
        <span class="section-label">{t.routeLabel}</span>
        <h2 class="section-title mt-4" set:html={t.routeTitleHtml}></h2>
        <p class="text-ink/50 mt-4 max-w-2xl mx-auto text-lg">
          {t.routeIntro}
        </p>
        <!-- C4 — Dates bien visibles -->
        <div class="inline-flex items-center gap-2 mt-6 px-4 py-2 rounded-full border border-accent/20 bg-gold/[0.06]">
          <svg class="w-4 h-4 text-accent/70 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <span class="font-mono text-sm text-accent/80 font-bold tracking-wider">{t.routeDates}</span>
        </div>
      </div>

      {/* La frise possède le quand, la carte le où. Les deux côte à côte, la
          frise en vedette — c'est la chronologie qui structure, pas la
          géographie (décisions D4 et D6). */}
      <div class="reveal grid lg:grid-cols-[1.6fr_1fr] gap-10 lg:gap-14 items-center">
        <TimelineParcours />
        <MapReunion />
      </div>

      <!-- Stage cards bento grid -->
      <div class="grid md:grid-cols-2 gap-6 mt-16">
        {stages.map(stage => <StageCard stage={stage} />)}
      </div>
    </div>
  </section>

  <!-- ===== REPLAY ===== -->
  <!-- #inscription reste une ancre : d'anciens liens partagés y pointent. -->
  <section id="replay" class="relative py-32 overflow-hidden scroll-mt-16">
    <span id="inscription" class="absolute -top-16" aria-hidden="true"></span>
    <div class="absolute inset-0 bg-gradient-to-b from-surface via-surface-2 to-surface"></div>
    <div class="absolute inset-0 cyber-grid opacity-30"></div>

    <div class="relative z-10 max-w-4xl mx-auto px-6">
      <div class="reveal mb-14 text-center">
        <span class="section-label">{t.replayLabel}</span>
        <h2 class="section-title mt-4" set:html={t.replayTitleHtml}></h2>
        <p class="text-ink/60 mt-4 max-w-2xl mx-auto text-lg">
          {t.replayIntro}
        </p>
      </div>

      {/* Lien vers YouTube plutôt qu'un lecteur intégré : aucun module tiers
          chargé sur le site. */}
      <a
        href={REPLAY_2026_URL}
        target="_blank"
        rel="noopener"
        aria-label={t.replayPlay}
        class="replay-poster reveal delay-1 group relative block mx-auto max-w-3xl overflow-hidden rounded-2xl border border-ink/10 shadow-2xl shadow-navy/50 light:shadow-navy/15"
      >
        <img src="/assets/bilan/2026-conferences-amphi.webp" alt={t.replayPosterAlt} width="1600" height="900" loading="lazy" class="block w-full h-auto" />
        <span class="absolute inset-0 flex items-center justify-center bg-navy-dark/30 transition-colors duration-300 group-hover:bg-navy-dark/10" aria-hidden="true">
          <span class="replay-play flex items-center justify-center w-20 h-20 rounded-full bg-clusir-red text-white shadow-lg shadow-navy-dark/40">
            <svg class="w-9 h-9 translate-x-0.5" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
          </span>
        </span>
      </a>

      <div class="reveal delay-2 mx-auto max-w-2xl mt-10">
        <div class="terminal-window theme-dark bg-[#060a14] backdrop-blur-md border border-accent/20 rounded-xl px-6 py-6 sm:px-8 font-mono text-sm">
          <div class="flex items-center gap-2 mb-4 pb-3 border-b border-ink/10">
            <span class="w-3 h-3 rounded-full bg-red/80" aria-hidden="true"></span>
            <span class="w-3 h-3 rounded-full bg-gold/60" aria-hidden="true"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-400/60" aria-hidden="true"></span>
            <span class="ml-3 text-ink/50 text-xs">{t.replayTermFile}</span>
          </div>

          <div class="space-y-2">
            <p class="text-emerald-400/80"><span class="text-accent/80">$</span> {t.replayTermCmd}</p>
            {t.replayTermLines.map(line => (
              <p class="text-ink/70">{line.label} <span class="text-accent">{line.value}</span></p>
            ))}
          </div>

          <div class="mt-6 flex flex-col sm:flex-row gap-3">
            <a
              href={p('/bilan')}
              class="inline-flex min-h-[44px] flex-1 items-center justify-center gap-2 rounded-lg border border-accent/40 bg-gold/10 px-4 py-3 font-display text-sm font-semibold text-accent transition-colors hover:bg-gold/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              {t.replayBilanCta}
            </a>
            <a
              href={p('/bilan#rejoindre')}
              class="inline-flex min-h-[44px] flex-1 items-center justify-center gap-2 rounded-lg border border-ink/20 bg-ink/[0.06] px-4 py-3 font-display text-sm font-semibold text-ink transition-colors hover:bg-ink/[0.12] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              {t.replayJoinCta}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PARTENAIRES (Pyramid) ===== -->
  <section id="partenaires" class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-surface via-surface-2 to-surface"></div>
    <div class="relative z-10">
      <div class="reveal mb-12 text-center px-6">
        <span class="section-label">{t.partnersLabel}</span>
        <h2 class="section-title mt-4" set:html={t.partnersTitleHtml}></h2>
        <p class="text-ink/50 mt-4 max-w-2xl mx-auto text-lg">
          {t.partnersIntro}
        </p>
      </div>
      <PartnerPyramid />
      <div class="reveal text-center pb-24 px-6">
        <a href={p('/partenaires')} class="btn-outline inline-flex items-center gap-2 rounded-lg font-display text-sm">
          {t.partnersCta}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== CTF CYBERMOIS ===== -->
  <!-- CTF du vendredi 23 octobre, pendant l'étape Sud, avec BSides Réunion. -->
  <section id="ctf" class="relative py-20 overflow-hidden">
    <div class="absolute inset-0 noise-overlay"></div>

    <div class="relative z-10 max-w-3xl mx-auto px-6">
      <div class="reveal relative bg-ink/[0.03] border border-ink/[0.06] rounded-2xl p-8 sm:p-10 overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-bl from-gold/5 to-transparent" aria-hidden="true"></div>

        <span class="section-label">{t.ctfLabel}</span>
        <h2 class="font-display font-bold text-3xl sm:text-4xl mt-4" set:html={t.ctfTitleHtml}></h2>

        <div class="flex flex-wrap items-center gap-3 mt-5">
          <span class="inline-flex items-center gap-1.5 bg-gold/10 border border-accent/20 rounded-full px-3 py-1 text-xs font-mono text-accent tracking-wider uppercase">
            <span class="w-1.5 h-1.5 bg-gold rounded-full"></span>
            {t.ctfBadgeMonth}
          </span>
          <span class="inline-flex items-center gap-1.5 bg-ink/5 border border-ink/10 rounded-full px-3 py-1 text-xs font-mono text-ink/60 tracking-wider uppercase">
            {t.ctfBadgeAllMonth}
          </span>
        </div>

        <p class="text-ink/70 leading-relaxed mt-5" set:html={t.ctfIntroHtml}></p>
        <p class="text-ink/60 leading-relaxed mt-3" set:html={t.ctfBodyHtml}></p>

        <div class="mt-6 text-center">
          <a href={p('/bilan#temps-forts')} class="btn-outline inline-block rounded-lg font-display text-sm">{t.ctfCta}</a>
        </div>

        <div class="flex flex-wrap items-center gap-4 mt-6">
          <span class="text-xs text-ink/50 font-mono tracking-wider">{t.ctfPartnersLabel}</span>
          <!-- Logo blanc et orange sur fond transparent : pas de pastille blanche. -->
          <a href="https://bsides-reunion.re" target="_blank" rel="noopener noreferrer" aria-label="BSides Réunion">
            <img src="/assets/logo-bsides-reunion.webp" alt="BSides Réunion" width="800" height="346" class="h-14 w-auto" loading="lazy" />
          </a>
        </div>
      </div>
    </div>
  </section>

  </main>

  <!-- ===== FOOTER ===== -->
  <Footer />

  <script>
    // Le décompte du hero monte jusqu'à sa valeur finale, en expo-out comme
    // les révélations du site. Le HTML porte déjà le chiffre final.
    const counters = document.querySelectorAll<HTMLElement>('[data-count]');
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const format = new Intl.NumberFormat(document.documentElement.lang === 'en' ? 'en-GB' : 'fr-FR');
      const duration = 1600;
      const start = performance.now() + 500;
      const write = (el: HTMLElement, progress: number) => {
        const target = Number(el.dataset.count);
        el.textContent = format.format(Math.round(target * progress)) + (progress === 1 ? el.dataset.suffix : '');
      };
      // Rien n'est écrit hors d'une image rendue : si requestAnimationFrame est
      // suspendu (onglet en arrière-plan), le chiffre final du HTML reste.
      const tick = (now: number) => {
        const t = Math.min(Math.max(now - start, 0) / duration, 1);
        const eased = t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
        counters.forEach((el) => write(el, eased));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  </script>


  <SponsorsFloating />
</Layout>
