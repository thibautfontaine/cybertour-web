---
/**
 * Page d'accueil, vue partagée par `/` (fr) et `/en/` (en).
 *
 * Aucune chaîne visible n'est écrite ici : tout vient de `src/i18n/home.ts`.
 * Ce fichier ne porte plus que la structure, les classes Tailwind et les
 * tracés SVG — les seuls littéraux qui restent sont des noms propres de
 * marque (« CYBER », « TOUR », « REUNION »), des adresses et des identifiants
 * techniques (ids d'ancre, chemins d'assets, UID du .ics).
 */
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MapReunion from '../components/MapReunion.astro';
import TimelineParcours from '../components/TimelineParcours.astro';
import StageCard from '../components/StageCard.astro';
import PartnerPyramid from '../components/PartnerPyramid.astro';
import { getStages } from '../data/stages';
import { WEEZEVENT_PAGE, weezeventWidgetUrl } from '../data/ticketing';
import { getLang, localizePath } from '../i18n';
import { home } from '../i18n/home';

const lang = getLang(Astro.currentLocale);
const t = home[lang];
const p = (path: string) => localizePath(path, lang);

const stages = getStages(lang);

const contactMail = 'evenement@clusir-roi.org';

/**
 * Icônes des quatre piliers « Pourquoi investir » (dossier partenaire V2.1,
 * p.19). Le texte est dans le dictionnaire, le tracé reste ici : il ne se
 * traduit pas.
 */
const pillarIcons: Record<string, string> = {
  visibilite:
    'M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178zM15 12a3 3 0 11-6 0 3 3 0 016 0z',
  reseau:
    'M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z',
  expertise:
    'M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18',
  talents:
    'M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5',
};

/**
 * Palette par palier de partenariat. Comme les icônes, ces classes ne se
 * traduisent pas : elles restent indexées par la clé stable du dictionnaire.
 */
const tierStyles: Record<
  string,
  {
    text: string;
    border: string;
    bg: string;
    hover: string;
    bar: string;
    cardBorder: string;
  }
> = {
  bronze: {
    text: 'text-amber-500',
    border: 'border-amber-700/50',
    bg: 'bg-amber-900/20',
    hover: 'hover:bg-amber-900/30',
    bar: 'from-amber-700 to-amber-900',
    cardBorder: 'border-amber-900/30',
  },
  silver: {
    text: 'text-gray-300',
    border: 'border-gray-400/50',
    bg: 'bg-gray-400/10',
    hover: 'hover:bg-gray-400/20',
    bar: 'from-gray-300 to-gray-500',
    cardBorder: 'border-gray-400/30',
  },
  gold: {
    text: 'text-gold',
    border: 'border-gold/50',
    bg: 'bg-gold/10',
    hover: 'hover:bg-gold/20',
    bar: 'from-gold-dim to-gold',
    cardBorder: 'border-gold/30',
  },
};

const mailtoSubject = (subject: string) =>
  `mailto:${contactMail}?subject=${encodeURIComponent(subject)}`;
---

<Layout title={t.metaTitle} description={t.metaDescription}>

  <!-- ===== NAVBAR ===== -->
  <Navbar />

  <!-- ===== HERO ===== -->
  <section id="main-content" class="relative min-h-dvh flex items-center justify-center overflow-hidden">
    <!-- Background image with overlay -->
    <div class="absolute inset-0">
      <img src="/assets/hero-bg.jpg" alt="" width="1920" height="1080" class="w-full h-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-b from-navy-dark/80 via-navy-dark/70 to-navy-dark"></div>
    </div>

    <!-- Grid overlay -->
    <div class="absolute inset-0 cyber-grid"></div>

    <!-- Scan line effect -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="absolute left-0 right-0 h-px bg-gold/20 animate-scan"></div>
    </div>

    <!-- Glow orbs -->
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-navy rounded-full animate-pulse-glow"></div>
    <div class="absolute bottom-1/4 right-1/4 w-64 h-64 bg-gold/20 rounded-full animate-pulse-glow" style="animation-delay: 2s;"></div>

    <!-- Floating island silhouette -->
    <div class="absolute right-0 bottom-0 w-[500px] h-[500px] opacity-[0.06] animate-float pointer-events-none">
      <img src="/assets/reunion-silhouette.png" alt="" class="w-full h-full object-contain" />
    </div>

    <!-- Hero content -->
    <div class="relative z-10 text-center px-6 max-w-5xl mx-auto">
      <!-- Event badge -->
      <div class="inline-flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-5 py-2 mb-8" style="animation: slide-up 0.8s ease-out both;">
        <span class="w-2 h-2 bg-gold rounded-full animate-pulse"></span>
        <span class="text-sm font-mono text-white/60 tracking-widest uppercase">{t.heroBadge}</span>
      </div>

      <!-- Main title -->
      <h1 class="font-display font-extrabold leading-[0.95] mb-6" style="animation: slide-up 0.8s ease-out 0.15s both;">
        <span class="glitch-wrapper block">
          <span class="glitch text-6xl sm:text-7xl md:text-8xl lg:text-9xl tracking-tight text-white" data-text="CYBER">CYBER</span>
        </span>
        <span class="block text-6xl sm:text-7xl md:text-8xl lg:text-9xl tracking-tight">
          <span class="text-gold">TOUR</span>
          <span class="text-white/20 ml-2 md:ml-4" aria-hidden="true">&#47;&#47;</span>
        </span>
        <span class="block text-3xl sm:text-4xl md:text-5xl tracking-[0.2em] mt-4 reunion-outline">REUNION</span>
      </h1>

      <!-- Date & location -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-8 mb-10" style="animation: slide-up 0.8s ease-out 0.3s both;">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <span class="font-display font-semibold text-lg tracking-wide">{t.heroDates}</span>
        </div>
        <span class="hidden sm:block w-1 h-1 bg-gold rounded-full"></span>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span class="font-display font-semibold text-lg tracking-wide">{t.heroPlaces}</span>
        </div>
      </div>

      <!-- CTA buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4" style="animation: slide-up 0.8s ease-out 0.45s both;">
        <a href={p('/#etapes')} class="btn-primary rounded-lg font-display">{t.heroCtaRoute}</a>
        <a href={p('/#contact')} class="btn-outline rounded-lg font-display text-sm">{t.heroCtaContact}</a>
      </div>

      <!-- Context pills — qualification rapide pour le visiteur -->
      <div class="flex flex-wrap items-center justify-center gap-3 mt-6" style="animation: slide-up 0.8s ease-out 0.55s both;">
        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-mono tracking-wider border border-emerald-400/25 bg-emerald-400/[0.07] text-emerald-400">
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 13l4 4L19 7"/></svg>
          {t.heroPillFree}
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-mono tracking-wider border border-gold/25 bg-gold/[0.07] text-gold">
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          {t.heroPillSeats}
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-mono tracking-wider border border-white/15 bg-white/[0.05] text-white/60">
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
          {t.heroPillHybrid}
        </span>
      </div>

      <!-- Countdown -->
      <div id="countdown" class="mt-16 flex items-center justify-center gap-6 sm:gap-10" style="animation: slide-up 0.8s ease-out 0.6s both;">
        <div class="text-center">
          <span id="cd-days" class="block font-mono text-3xl sm:text-4xl font-bold text-gold tabular-nums">---</span>
          <span class="text-xs text-white/55 uppercase tracking-widest">{t.cdDays}</span>
        </div>
        <span class="text-white/20 text-2xl font-light" aria-hidden="true">:</span>
        <div class="text-center">
          <span id="cd-hours" class="block font-mono text-3xl sm:text-4xl font-bold text-white tabular-nums">--</span>
          <span class="text-xs text-white/55 uppercase tracking-widest">{t.cdHours}</span>
        </div>
        <span class="text-white/20 text-2xl font-light" aria-hidden="true">:</span>
        <div class="text-center">
          <span id="cd-mins" class="block font-mono text-3xl sm:text-4xl font-bold text-white tabular-nums">--</span>
          <span class="text-xs text-white/55 uppercase tracking-widest">{t.cdMins}</span>
        </div>
        <span class="text-white/20 text-2xl font-light" aria-hidden="true">:</span>
        <div class="text-center">
          <span id="cd-secs" class="block font-mono text-3xl sm:text-4xl font-bold text-white/50 tabular-nums">--</span>
          <span class="text-xs text-white/55 uppercase tracking-widest">{t.cdSecs}</span>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/50">
      <span class="text-xs tracking-widest uppercase">{t.scroll}</span>
      <div class="w-px h-8 bg-gradient-to-b from-white/30 to-transparent"></div>
    </div>
  </section>

  <!-- ===== ABOUT ===== -->
  <section id="about" class="relative py-32 overflow-hidden">
    <div class="absolute inset-0 noise-overlay"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6">
      <!-- Section header -->
      <div class="reveal mb-20">
        <span class="section-label">{t.aboutLabel}</span>
        <h2 class="section-title mt-4" set:html={t.aboutTitleHtml}></h2>
      </div>

      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <!-- Text block -->
        <div class="space-y-8">
          <p class="reveal delay-1 text-lg text-white/70 leading-relaxed" set:html={t.aboutP1Html}></p>
          <p class="reveal delay-2 text-lg text-white/70 leading-relaxed" set:html={t.aboutP2Html}></p>

          <!-- Stats -->
          <div class="reveal delay-3 grid grid-cols-3 gap-6 pt-6">
            {t.aboutStats.map(stat => (
              <div class="text-center p-4 bg-white/[0.03] border border-white/[0.06] rounded-xl">
                <span class="block font-display font-extrabold text-3xl text-gold">{stat.value}</span>
                <span class="text-sm text-white/50 mt-1">{stat.label}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Visual block -->
        <div class="reveal-right delay-2 relative">
          <div class="relative rounded-2xl overflow-hidden border border-white/10">
            <img src="/assets/cybertour-asset-web-site.png" alt={t.aboutImgAlt} class="w-full h-auto" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-dark/60 to-transparent"></div>
          </div>
          <!-- Decorative shield -->
          <div class="absolute -top-8 -right-8 w-24 h-24 text-gold/20 animate-float" style="animation-delay: 1s;">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2L3 7v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-9-5z"/>
            </svg>
          </div>
          <!-- Glow -->
          <div class="absolute -bottom-12 -left-12 w-48 h-48 bg-navy rounded-full blur-[80px] opacity-60"></div>
        </div>
      </div>

      <!-- P3 — Micro-CTA vers le parcours -->
      <div class="reveal delay-4 flex items-center justify-center mt-16 pt-10 border-t border-white/[0.05]">
        <a
          href={p('/#etapes')}
          class="group inline-flex items-center gap-3 py-3 font-mono text-sm text-white/50 hover:text-gold transition-colors duration-200 tracking-wide"
        >
          <span>{t.aboutCta}</span>
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== RETOUR SUR 2025 ===== -->
  <section id="replay" class="relative py-32 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-navy-dark via-slate-deep to-navy-dark"></div>
    <div class="absolute inset-0 cyber-grid opacity-20"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-6">
      <div class="reveal text-center mb-14">
        <span class="section-label">{t.replayLabel}</span>
        <h2 class="section-title mt-4" set:html={t.replayTitleHtml}></h2>
        <p class="text-white/50 mt-4 max-w-2xl mx-auto text-lg">
          {t.replayIntro}
        </p>
      </div>

      <!-- Stats 2025 -->
      <div class="reveal delay-1 grid grid-cols-3 gap-6 max-w-2xl mx-auto mb-12">
        {t.replayStats.map(stat => (
          <div class="text-center p-4 bg-white/[0.03] border border-white/[0.06] rounded-xl">
            <span class="block font-display font-extrabold text-3xl text-gold">{stat.value}</span>
            <span class="text-sm text-white/50 mt-1">{stat.label}</span>
          </div>
        ))}
      </div>

      <div class="reveal delay-2">
        <div class="relative rounded-2xl overflow-hidden border border-white/10 shadow-2xl shadow-navy/50 aspect-video">
          <iframe
            src="https://www.youtube-nocookie.com/embed/uk-gSyaxyWA?start=9748"
            title={t.replayIframeTitle}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
            class="absolute inset-0 w-full h-full"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CARTE DU TOUR / ÉTAPES ===== -->
  <section id="etapes" class="relative py-32 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-deep to-navy-dark"></div>
    <div class="absolute inset-0 cyber-grid opacity-50"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6">
      <div class="reveal mb-16 text-center">
        <span class="section-label">{t.routeLabel}</span>
        <h2 class="section-title mt-4" set:html={t.routeTitleHtml}></h2>
        <p class="text-white/50 mt-4 max-w-2xl mx-auto text-lg">
          {t.routeIntro}
        </p>
        <!-- C4 — Dates bien visibles -->
        <div class="inline-flex items-center gap-2 mt-6 px-4 py-2 rounded-full border border-gold/20 bg-gold/[0.06]">
          <svg class="w-4 h-4 text-gold/70 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
          </svg>
          <span class="font-mono text-sm text-gold/80 font-bold tracking-wider">{t.routeDates}</span>
        </div>
      </div>

      {/* Les principes de fonctionnement de la charte d'accueil. Le
          message d'unité n'est pas un slogan écrit pour le site : il est déjà
          rédigé dans le document que signent les hôtes. */}
      <ul class:list={[
        "reveal grid gap-4 mx-auto mb-16 list-none m-0 p-0",
        t.charter.length === 2 ? "sm:grid-cols-2 max-w-3xl" : "sm:grid-cols-3 max-w-4xl",
      ]}>
        {t.charter.map(item => (
          <li class="bg-white/[0.03] border border-white/[0.06] rounded-xl p-5">
            <p class="font-display font-semibold text-white">{item.title}</p>
            <p class="text-white/50 text-sm mt-1">{item.text}</p>
          </li>
        ))}
      </ul>

      {/* La frise possède le quand, la carte le où. Les deux côte à côte, la
          frise en vedette — c'est la chronologie qui structure, pas la
          géographie (décisions D4 et D6). */}
      <div class="reveal grid lg:grid-cols-[1.6fr_1fr] gap-10 lg:gap-14 items-center">
        <TimelineParcours />
        <MapReunion />
      </div>

      <!-- Stage cards bento grid -->
      <div class="grid md:grid-cols-2 gap-6 mt-16">
        {stages.map(stage => <StageCard stage={stage} />)}
      </div>
    </div>
  </section>

  <!-- ===== CTF CYBERMOIS ===== -->
  <section id="ctf" class="relative py-32 overflow-hidden">
    <div class="absolute inset-0 noise-overlay"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-6">
      <div class="reveal mb-16 text-center">
        <span class="section-label">{t.ctfLabel}</span>
        <h2 class="section-title mt-4" set:html={t.ctfTitleHtml}></h2>
        <!-- Accent éditorial en Ambroise. C'est une phrase d'exergue, en corps
             de titrage : le terrain naturel d'une didone. `.font-serif` porte
             l'ajustement optique (+8% de corps, interlignage resserré) et
             `font-synthesis: none`, qui interdit toute fausse graisse ou faux
             oblique — Ambroise n'a qu'une romaine 400. -->
        <p class="font-serif text-white/60 mt-5 max-w-2xl mx-auto text-2xl md:text-3xl">
          {t.ctfPullQuote}
        </p>
        <p class="text-white/50 mt-4 max-w-2xl mx-auto text-lg" set:html={t.ctfIntroHtml}></p>
      </div>

      <div class="reveal delay-1 max-w-3xl mx-auto">
        <div class="relative bg-white/[0.03] border border-white/[0.06] rounded-2xl p-8 sm:p-10 overflow-hidden">
          <!-- Decorative corner -->
          <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-bl from-gold/5 to-transparent"></div>

          <div class="flex flex-col sm:flex-row items-start gap-6">
            <!-- Icon -->
            <div class="shrink-0 w-16 h-16 rounded-xl bg-gold/10 border border-gold/20 flex items-center justify-center">
              <svg class="w-8 h-8 text-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path d="M3 3v1.5M3 21v-6m0 0 2.77-.693a9 9 0 0 1 6.208.682l.108.054a9 9 0 0 0 6.086.71l3.114-.732a48.524 48.524 0 0 1-.005-10.499l-3.11.732a9 9 0 0 1-6.085-.711l-.108-.054a9 9 0 0 0-6.208-.682L3 4.5M3 15V4.5"/>
              </svg>
            </div>

            <!-- Content -->
            <div class="space-y-4">
              <div class="flex flex-wrap items-center gap-3">
                <span class="inline-flex items-center gap-1.5 bg-gold/10 border border-gold/20 rounded-full px-3 py-1 text-xs font-mono text-gold tracking-wider uppercase">
                  <span class="w-1.5 h-1.5 bg-gold rounded-full animate-pulse"></span>
                  {t.ctfBadgeMonth}
                </span>
                <span class="inline-flex items-center gap-1.5 bg-white/5 border border-white/10 rounded-full px-3 py-1 text-xs font-mono text-white/60 tracking-wider uppercase">
                  {t.ctfBadgeAllMonth}
                </span>
              </div>

              <p class="text-white/70 leading-relaxed" set:html={t.ctfBodyHtml}></p>

              <div class="pt-3 text-center">
                <span class="text-xs text-white/50 font-mono tracking-wider block mb-3">{t.ctfPartnersLabel}</span>
                <div class="flex flex-wrap items-center justify-center gap-4">
