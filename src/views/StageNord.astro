---
/**
 * Vue partagée de l'étape Nord (FR `/nord`, EN `/en/nord`).
 * Toute chaîne visible vient de `src/i18n/nord.ts`.
 */
import StageLayout from '../layouts/StageLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getStage, ACCENT_TEXT } from '../data/stages';
import { getLang } from '../i18n';
import { nord } from '../i18n/nord';
import ProgrammeTimeline from '../components/ProgrammeTimeline.astro';
import PartnerLogo from '../components/PartnerLogo.astro';
import { getPartners } from '../data/partners';

const lang = getLang(Astro.currentLocale);
const t = nord[lang];
const stage = getStage(lang, 'nord');

const coOrganisers = getPartners(['prefecture', 'clusir']);
---

<StageLayout stage={stage}>
  <Navbar slot="navbar" currentPage="nord" />

  <section class="py-20">
    <div class="max-w-5xl mx-auto px-6">
      <div class="reveal mb-12">
        <span class="font-mono text-sm tracking-widest uppercase" style={`color: ${ACCENT_TEXT}CC;`}>{t.programmeLabel}</span>
        <h2 class="font-display font-bold text-3xl sm:text-4xl mt-4">{t.programmeTitle}</h2>
        <p class="text-white/50 mt-4 text-lg">{t.programmeSubtitle}</p>
      </div>

      <!-- Programme de la matinée -->
      <div class="reveal delay-1">
        <h3 class="font-display font-semibold text-2xl mb-6">{t.scheduleTitle}</h3>
        <ProgrammeTimeline sessions={t.programme} accent="red" />
      </div>

      <!-- Après-midi : ciné-débat -->
      <div class="reveal delay-2 mt-16">
        <span class="font-mono text-sm tracking-widest uppercase" style={`color: ${ACCENT_TEXT}CC;`}>{t.afternoonLabel}</span>
        <h2 class="font-display font-bold text-3xl sm:text-4xl mt-4">{t.afternoonTitle}</h2>
        <p class="text-white/50 mt-4 text-lg">{t.afternoonText}</p>
      </div>

      <!-- Organisateurs : Préfecture et CLUSIR -->
      <div class="reveal delay-3 mt-16">
        <h3 class="font-display font-semibold text-xl mb-8">{t.coOrganisersTitle}</h3>
        <div class="flex flex-wrap items-center justify-center gap-8">
          {coOrganisers.map((p) => <PartnerLogo partner={p} size={p.size.stage} />)}
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</StageLayout>
