---
/**
 * Carte SVG de Madagascar — étape internationale du CyberTour Océan Indien.
 * Silhouette inline (pas de PNG), point pulsant sur Antananarivo (lieu confirmé)
 * et un fil "câble sous-marin" vers l'Est pour évoquer le thème maritime
 * « Cybersecurity from Lands to Seas ».
 */
const accent = "#2dd4bf"; // teal océan — différencie Madagascar de l'or réunionnais
---

<section id="carte" class="reveal relative py-20 md:py-28 overflow-hidden">
  <!-- Section heading -->
  <div class="text-center mb-12 md:mb-16 px-4">
    <p class="font-mono text-xs tracking-widest uppercase mb-3" style={`color: ${accent}AA;`}>
      // ÉTAPE INTERNATIONALE · SWIO
    </p>
    <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-white">
      Cap sur Antananarivo
    </h2>
    <p class="text-white/50 mt-4 max-w-xl mx-auto font-body">
      Une étape sur les hautes terres malgaches, reliée à l'océan qui unit la zone.
    </p>
  </div>

  <!-- Map container — wrapper is exactly square so % coords match SVG viewBox -->
  <div class="relative mx-auto max-w-3xl px-4">
    <div
      class="relative mx-auto"
      style="aspect-ratio: 1 / 1; max-height: 70vh; width: 100%;"
    >
      <img
        src="/assets/mada.svg"
        alt="Carte de Madagascar — étape d'Antananarivo, CyberTour Océan Indien"
        class="absolute inset-0 w-full h-full block"
        style={`object-fit: contain; filter: drop-shadow(0 0 30px ${accent}33) drop-shadow(0 0 60px ${accent}14);`}
        loading="lazy"
        decoding="async"
      />

      <!-- Connector line from pin (53.7%, 50.6%) to bubble anchor (left side of bubble) -->
      <svg
        class="absolute inset-0 w-full h-full pointer-events-none"
        viewBox="0 0 1896 1896"
        aria-hidden="true"
      >
        <line
          x1="1018" y1="959"
          x2="1240" y2="940"
          stroke={accent}
          stroke-width="3"
          stroke-dasharray="6 6"
          opacity="0.55"
        />
      </svg>

      <!-- Info bubble — anchored next to the GPS pin (SVG pin at 53.7% / 50.6%) -->
      <a
        href="#programme"
        class="group absolute flex flex-col items-start"
        style="left: 65.5%; top: 49.5%; transform: translateY(-50%); max-width: 32%;"
        aria-label="Programme de l'étape Antananarivo"
      >
        <span
          class="rounded-lg bg-[#0f1a30]/95 backdrop-blur-md px-3 py-2 md:px-4 md:py-2.5 border-2 shadow-lg transition-all duration-300 group-hover:scale-105"
          style={`border-color: ${accent}66; box-shadow: 0 4px 20px rgba(0,0,0,0.55);`}
        >
          <span class="block font-mono text-xs md:text-sm font-bold tracking-wider uppercase" style={`color: ${accent};`}>
            Novembre 2026
          </span>
          <span class="block font-body text-xs md:text-sm text-white font-medium leading-tight mt-0.5 whitespace-nowrap">
            Université d'Antananarivo
          </span>
        </span>
      </a>
    </div>
  </div>

  <!-- Theme strip -->
  <div class="relative mt-12 md:mt-16 mx-auto max-w-3xl px-6">
    <div
      class="rounded-2xl border px-6 py-5 text-center"
      style={`border-color: ${accent}30; background: ${accent}0A;`}
    >
      <p class="font-mono text-xs tracking-widest uppercase mb-1" style={`color: ${accent}CC;`}>
        Thématique
      </p>
      <p class="font-display text-lg md:text-2xl font-bold text-white italic">
        « Cybersecurity from Lands to Seas »
      </p>
      <p class="text-white/50 text-sm mt-2 font-body">
        Du cyber terrestre à la sûreté maritime — câbles sous-marins, ports, surveillance des espaces océaniques.
      </p>
    </div>
  </div>
</section>
