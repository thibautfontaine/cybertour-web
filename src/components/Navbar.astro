---
interface Props {
  currentPage?: string;
}

const { currentPage } = Astro.props;

// Les ancres de la home suivent l'ordre des sections de index.astro.
// Les liens `page: true` (surfaces dédiées) sont regroupés visuellement.
interface NavLink {
  label: string;
  href: string;
  /** Surface dédiée (page complète) plutôt qu'une ancre de la home */
  page?: boolean;
  /** Étape internationale */
  intl?: boolean;
  /** Non encore ouvert — rendu en texte non cliquable + badge « bientôt » */
  soon?: boolean;
}

const navLinks: NavLink[] = [
  { label: "À propos", href: "/#about" },
  { label: "Replay 2025", href: "/#replay" },
  { label: "Les Étapes", href: "/#etapes" },
  { label: "Madagascar", href: "/madagascar", intl: true, page: true },
  { label: "Jobs & Stages", href: "/jobs", page: true },
  { label: "CTF", href: "/#ctf" },
  { label: "Speakers", href: "/#speakers" },
  { label: "Sponsors", href: "/#sponsors" },
  { label: "Inscriptions", href: "/#inscription", soon: true },
];

const isGroupStart = (i: number) => navLinks[i].page && !navLinks[i - 1]?.page;
const isGroupEnd = (i: number) => navLinks[i].page && !navLinks[i + 1]?.page;

const ctaLink = { label: "Contact", href: "/#contact" };
---

<nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 bg-transparent transition-all duration-300" data-scrolled="false">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 group">
      <img src="/assets/logo-clusir-roi-sombre.png" alt="CLUSIR Réunion Océan Indien" class="h-14 sm:h-16 w-auto transition-transform group-hover:scale-105" />
    </a>

    <!-- Desktop nav -->
    <!-- Nav desktop à partir de lg : 9 liens + CTA débordent sous 1024px -->
    <div class="hidden lg:flex items-center gap-4 xl:gap-6">
      {navLinks.map((link, i) => (
        <>
          {isGroupStart(i) && <span aria-hidden="true" class="w-px h-4 bg-white/15"></span>}
          {link.soon ? (
            <span class="inline-flex items-center gap-2 cursor-default select-none">
              <span class="text-xs xl:text-sm font-medium tracking-wider uppercase text-white/50">{link.label}</span>
              <span class="text-[10px] font-mono uppercase tracking-wider rounded-full px-2 py-0.5 border border-gold/40 bg-gold/10 text-gold">bientôt</span>
            </span>
          ) : (
            <a
              href={link.href}
              class:list={[
                "text-xs xl:text-sm font-medium hover:text-gold transition-colors tracking-wider uppercase whitespace-nowrap",
                currentPage && link.href.startsWith(`/${currentPage}`)
                  ? "text-gold"
                  : "text-white/70",
              ]}
            >
              {link.label}
            </a>
          )}
          {isGroupEnd(i) && <span aria-hidden="true" class="w-px h-4 bg-white/15"></span>}
        </>
      ))}
      <a href={ctaLink.href} class="btn-outline text-xs py-2 px-5">{ctaLink.label}</a>
    </div>

    <!-- Mobile burger -->
    <button id="menu-toggle" class="lg:hidden text-white" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-navy-dark/95 backdrop-blur-lg border-t border-white/10">
    <div class="px-6 py-4 flex flex-col gap-4">
      {navLinks.map((link) => (
        link.soon ? (
          <span class="inline-flex items-center gap-2 cursor-default select-none">
            <span class="text-sm font-medium uppercase text-white/50">{link.label}</span>
            <span class="text-[10px] font-mono uppercase tracking-wider rounded-full px-2 py-0.5 border border-gold/40 bg-gold/10 text-gold">bientôt</span>
          </span>
        ) : (
          <a
            href={link.href}
            class:list={[
              "text-sm font-medium hover:text-gold transition-colors uppercase",
              currentPage && link.href.startsWith(`/${currentPage}`)
                ? "text-gold"
                : "text-white/70",
            ]}
          >
            {link.label}
          </a>
        )
      ))}
      <a href={ctaLink.href} class="text-sm font-medium text-white/70 hover:text-gold transition-colors uppercase">{ctaLink.label}</a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('main-nav');
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = mobileMenu?.querySelectorAll('a');

  // Scroll — add background when user scrolls past 60px
  function onScroll() {
    if (!nav) return;
    const scrolled = window.scrollY > 60;
    nav.style.backgroundColor = scrolled ? 'var(--nav-scrolled)' : 'transparent';
    nav.style.backdropFilter = scrolled ? 'blur(12px)' : 'none';
    nav.style.borderBottom = scrolled ? '1px solid rgba(255,255,255,0.06)' : 'none';
    nav.dataset.scrolled = String(scrolled);
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll(); // run on page load in case of direct anchor navigation

  // Mobile menu — unique propriétaire du toggle (aucun autre listener sur
  // #menu-toggle ailleurs dans le site, sinon les bascules s'annulent).
  function isMenuOpen() {
    return mobileMenu?.classList.contains('hidden') === false;
  }

  function setMenu(open) {
    if (!mobileMenu || !menuToggle) return;
    mobileMenu.classList.toggle('hidden', !open);
    menuToggle.setAttribute('aria-expanded', String(open));
    menuToggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
  }

  // État initial cohérent avec le DOM rendu (menu fermé)
  setMenu(isMenuOpen());

  menuToggle?.addEventListener('click', () => {
    setMenu(!isMenuOpen());
  });

  // Fermeture au clic sur un lien
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => setMenu(false));
  });

  // Fermeture au clavier (Escape) + focus rendu au bouton
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMenuOpen()) {
      setMenu(false);
      menuToggle?.focus();
    }
  });
</script>
