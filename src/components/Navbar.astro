---
import { getLang, localizePath, alternatePath, otherLang, LANGS, LANG_STORAGE_KEY } from '../i18n';
import { ui } from '../i18n/ui';
import { getStages } from '../data/stages';

interface Props {
  currentPage?: string;
}

const { currentPage } = Astro.props;

const lang = getLang(Astro.currentLocale);
const t = ui[lang].nav;
const p = (path: string) => localizePath(path, lang);

// Les ancres de la home suivent l'ordre des sections de index.astro.
// Les libellés vivent dans src/i18n/ui.ts ; `soon` = non encore ouvert,
// rendu en texte non cliquable + badge « bientôt ».
const navLinks = t.links.map((link) => ({ ...link, href: p(link.href) }));
const ctaLink = { label: t.cta.label, href: p(t.cta.href) };

// Menu « Les étapes » : les sept étapes dans l'ordre du tour. Celles qui ont
// une page (`published`) sont des liens, les autres restent visibles, grisées.
const stages = getStages(lang);
const stagesAllHref = p(t.stagesMenu.allHref);
const onStagePage = stages.some((s) => s.published && s.id === currentPage);

// Menu « À propos » : présentation, édition 2025 et contact, sur /a-propos.
const aboutItems = t.aboutMenu.items.map((item) => ({ ...item, href: p(item.href) }));
const onAboutPage = currentPage === 'a-propos';

/* Sélecteur de langue : un lien par langue vers la même page dans l'autre
   langue. Le clic écrit localStorage[ct-lang] (voir le script plus bas) — c'est
   la seule écriture de cette clé, et elle prime ensuite sur la détection
   automatique de src/i18n/redirect.js. */
const langLinks = LANGS.map((l) => ({
  lang: l,
  code: l.toUpperCase(),
  name: t.langNames[l],
  href: l === lang ? Astro.url.pathname : alternatePath(Astro.url.pathname, l),
  current: l === lang,
}));

const isCurrent = (href: string) =>
  Boolean(currentPage) && href.startsWith(p(`/${currentPage}`));
---

<nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 bg-transparent transition-all duration-300" data-scrolled="false">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- shrink-0 obligatoire : sans lui, flexbox comprime le logo en largeur
         quand la barre de liens deborde, ce qui l'ecrase en un trait vertical -->
    <a href={p('/')} class="flex items-center gap-1.5 sm:gap-2.5 group shrink-0">
      <!-- Logos en couleur, chacun sur sa pastille blanche : leurs textes
           sombres seraient illisibles sur le fond de la barre. -->
      <span class="logo-white-bg flex items-center rounded-lg h-9 sm:h-14 px-1.5 sm:px-2.5 shrink-0">
        <img src="/assets/logo-cybertour-2026-couleur.webp" alt={t.logoCyberTourAlt} width="395" height="256" class="h-7 sm:h-10 w-auto max-w-none" />
      </span>
      <span class="logo-white-bg flex items-center rounded-lg h-9 sm:h-14 px-1.5 sm:px-2.5 shrink-0">
        <img src="/assets/logo-clusir-roi.png" alt={t.logoAlt} width="860" height="422" class="h-6 sm:h-10 w-auto max-w-none" />
      </span>
      <span class="logo-white-bg flex items-center rounded-lg h-9 sm:h-14 px-1.5 sm:px-2.5 shrink-0">
        <img src="/assets/logo-prefecture-reunion.png" alt={t.logoPrefectureAlt} width="878" height="600" class="h-7 sm:h-11 w-auto max-w-none" />
      </span>
    </a>

    <div class="flex items-center gap-4 xl:gap-6">
      <!-- Desktop nav -->
      <!-- Nav desktop à partir de lg : 7 liens + CTA débordent sous 1024px -->
      <div class="hidden lg:flex items-center gap-4 xl:gap-6">
        <!-- Menu « Les étapes » : s'ouvre au survol, au clic, au toucher et au
             clavier (Entrée, Espace) ; se ferme avec Échap ou un clic ailleurs. -->
        <div class="relative" id="stages-dropdown" data-dropdown>
          <button
            type="button"
            id="stages-toggle"
            data-dropdown-toggle
            aria-expanded="false"
            aria-controls="stages-menu"
            class:list={[
              "inline-flex items-center gap-1.5 text-xs xl:text-sm font-medium hover:text-gold transition-colors tracking-wider uppercase whitespace-nowrap",
              onStagePage ? "text-gold" : "text-white/70",
            ]}
          >
            {t.stagesMenu.label}
            <svg class="w-3.5 h-3.5 transition-transform" data-chevron fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
            </svg>
          </button>
          <!-- pt-3 : pont invisible entre le bouton et le panneau, pour que le
               survol ne se perde pas en descendant la souris. -->
          <div id="stages-menu" data-dropdown-menu class="hidden absolute left-1/2 -translate-x-1/2 top-full pt-3 w-96">
            <div class="rounded-xl border border-white/10 bg-navy-dark/95 backdrop-blur-lg shadow-2xl p-2">
              <ul class="list-none m-0 p-0">
                {stages.map((stage) => (
                  <li>
                    {stage.published ? (
                      <a
                        href={stage.href}
                        aria-current={stage.id === currentPage ? 'page' : undefined}
                        class:list={[
                          "flex items-baseline justify-between gap-3 rounded-lg px-3 py-2 hover:bg-white/[0.06] focus-visible:bg-white/[0.06] transition-colors",
                          stage.id === currentPage && "bg-white/[0.04]",
                        ]}
                      >
                        <span>
                          <span class:list={["block text-sm font-semibold", stage.id === currentPage ? "text-gold" : "text-white"]}>{stage.direction} · {stage.commune}</span>
                          <span class="block text-xs text-white/50">{stage.host}</span>
                        </span>
                        <span class="font-mono text-[11px] text-white/60 whitespace-nowrap">{stage.dateShort}</span>
                      </a>
                    ) : (
                      <span class="flex items-baseline justify-between gap-3 px-3 py-2 cursor-default">
                        <span>
                          <span class="block text-sm font-semibold text-white/40">{stage.direction} · {stage.commune}</span>
                          <span class="block text-xs text-white/35">{stage.host} · {t.stagesMenu.soon}</span>
                        </span>
                        <span class="font-mono text-[11px] text-white/35 whitespace-nowrap">{stage.dateShort}</span>
                      </span>
                    )}
                  </li>
                ))}
              </ul>
              <a href={stagesAllHref} class="mt-1 block border-t border-white/10 px-3 pt-3 pb-2 text-xs font-mono uppercase tracking-wider text-gold hover:text-white transition-colors">
                {t.stagesMenu.all} →
              </a>
            </div>
          </div>
        </div>
        {navLinks.map((link) => (
          <>
            {link.soon ? (
              <span class="inline-flex items-center gap-2 cursor-default select-none">
                <span class="text-xs xl:text-sm font-medium tracking-wider uppercase text-white/50">{link.label}</span>
                <span class="text-[10px] font-mono uppercase tracking-wider rounded-full px-2 py-0.5 border border-gold/40 bg-gold/10 text-gold">{t.soon}</span>
              </span>
            ) : (
              <a
                href={link.href}
                class:list={[
                  "text-xs xl:text-sm font-medium hover:text-gold transition-colors tracking-wider uppercase whitespace-nowrap",
                  isCurrent(link.href) ? "text-gold" : "text-white/70",
                ]}
              >
                {link.label}
              </a>
            )}
          </>
        ))}
        <div class="relative" id="about-dropdown" data-dropdown>
          <button
            type="button"
            id="about-toggle"
            data-dropdown-toggle
            aria-expanded="false"
            aria-controls="about-menu"
            class:list={[
              "inline-flex items-center gap-1.5 text-xs xl:text-sm font-medium hover:text-gold transition-colors tracking-wider uppercase whitespace-nowrap",
              onAboutPage ? "text-gold" : "text-white/70",
            ]}
          >
            {t.aboutMenu.label}
            <svg class="w-3.5 h-3.5 transition-transform" data-chevron fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
            </svg>
          </button>
          <div id="about-menu" data-dropdown-menu class="hidden absolute left-1/2 -translate-x-1/2 top-full pt-3 w-56">
            <ul class="list-none m-0 rounded-xl border border-white/10 bg-navy-dark/95 backdrop-blur-lg shadow-2xl p-2">
              {aboutItems.map((item) => (
                <li>
                  <a href={item.href} class="block rounded-lg px-3 py-2 text-sm font-semibold text-white hover:bg-white/[0.06] focus-visible:bg-white/[0.06] hover:text-gold transition-colors">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <a href={ctaLink.href} class="btn-outline text-xs py-2 px-5">{ctaLink.label}</a>
      </div>

      <!-- Sélecteur de langue — visible à toutes les largeurs -->
      <div
        class="inline-flex items-center rounded-full border border-white/15 bg-white/[0.04] font-mono text-[11px] tracking-wider uppercase"
        role="group"
        aria-label={t.langSwitcher}
      >
        {langLinks.map((l, i) => (
          <>
            {i > 0 && <span class="text-white/15 select-none" aria-hidden="true">|</span>}
            <a
              href={l.href}
              hreflang={l.lang}
              lang={l.lang}
              data-set-lang={l.lang}
              aria-current={l.current ? 'true' : undefined}
              aria-label={l.name}
              class:list={[
                "px-2.5 py-1 transition-colors",
                l.current ? "text-gold font-bold" : "text-white/60 hover:text-white",
              ]}
            >
              {l.code}
            </a>
          </>
        ))}
      </div>

      <!-- Mobile burger -->
      <button
        id="menu-toggle"
        class="lg:hidden text-white"
        aria-label={t.openMenu}
        data-label-open={t.openMenu}
        data-label-close={t.closeMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-navy-dark/95 backdrop-blur-lg border-t border-white/10">
    <div class="px-6 py-4 flex flex-col gap-4">
      <div>
        <span class="text-sm font-medium uppercase text-white/50">{t.stagesMenu.label}</span>
        <ul class="list-none m-0 mt-2 p-0 flex flex-col gap-2 border-l border-white/10 pl-4">
          {stages.map((stage) => (
            <li>
              {stage.published ? (
                <a href={stage.href} class:list={["text-sm hover:text-gold transition-colors", stage.id === currentPage ? "text-gold" : "text-white/80"]}>
                  {stage.direction} · {stage.commune} <span class="font-mono text-[11px] text-white/50 ml-1">{stage.dateShort}</span>
                </a>
              ) : (
                <span class="text-sm text-white/35">
                  {stage.direction} · {stage.commune} <span class="font-mono text-[11px] ml-1">{stage.dateShort}</span>
                </span>
              )}
            </li>
          ))}
          <li><a href={stagesAllHref} class="text-xs font-mono uppercase tracking-wider text-gold">{t.stagesMenu.all} →</a></li>
        </ul>
      </div>
      {navLinks.map((link) => (
        link.soon ? (
          <span class="inline-flex items-center gap-2 cursor-default select-none">
            <span class="text-sm font-medium uppercase text-white/50">{link.label}</span>
            <span class="text-[10px] font-mono uppercase tracking-wider rounded-full px-2 py-0.5 border border-gold/40 bg-gold/10 text-gold">{t.soon}</span>
          </span>
        ) : (
          <a
            href={link.href}
            class:list={[
              "text-sm font-medium hover:text-gold transition-colors uppercase",
              isCurrent(link.href) ? "text-gold" : "text-white/70",
            ]}
          >
            {link.label}
          </a>
        )
      ))}
      <div>
        <span class="text-sm font-medium uppercase text-white/50">{t.aboutMenu.label}</span>
        <ul class="list-none m-0 mt-2 p-0 flex flex-col gap-2 border-l border-white/10 pl-4">
          {aboutItems.map((item) => (
            <li><a href={item.href} class="text-sm text-white/80 hover:text-gold transition-colors">{item.label}</a></li>
          ))}
        </ul>
      </div>
      <a href={ctaLink.href} class="text-sm font-medium text-white/70 hover:text-gold transition-colors uppercase">{ctaLink.label}</a>
    </div>
  </div>
</nav>

<script define:vars={{ storageKey: LANG_STORAGE_KEY }} is:inline>
  // Choix manuel de langue : mémorisé avant la navigation naturelle du lien.
  // Seul endroit du site qui écrit cette clé (cf. src/i18n/redirect.js).
  document.addEventListener('click', function (event) {
    var link = event.target instanceof Element ? event.target.closest('a[data-set-lang]') : null;
    if (!link) return;
    try { window.localStorage.setItem(storageKey, link.getAttribute('data-set-lang')); } catch (_) {}
  });
</script>

<script>
  const nav = document.getElementById('main-nav');
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = mobileMenu?.querySelectorAll('a');

  // Scroll — add background when user scrolls past 60px
  function onScroll() {
    if (!nav) return;
    const scrolled = window.scrollY > 60;
    nav.style.backgroundColor = scrolled ? 'var(--nav-scrolled)' : 'transparent';
    nav.style.backdropFilter = scrolled ? 'blur(12px)' : 'none';
    nav.style.borderBottom = scrolled ? '1px solid rgba(255,255,255,0.06)' : 'none';
    nav.dataset.scrolled = String(scrolled);
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll(); // run on page load in case of direct anchor navigation

  // Mobile menu — unique propriétaire du toggle (aucun autre listener sur
  // #menu-toggle ailleurs dans le site, sinon les bascules s'annulent).
  function isMenuOpen() {
    return mobileMenu?.classList.contains('hidden') === false;
  }

  function setMenu(open: boolean) {
    if (!mobileMenu || !menuToggle) return;
    mobileMenu.classList.toggle('hidden', !open);
    menuToggle.setAttribute('aria-expanded', String(open));
    const label = open ? menuToggle.dataset.labelClose : menuToggle.dataset.labelOpen;
    if (label) menuToggle.setAttribute('aria-label', label);
  }

  // État initial cohérent avec le DOM rendu (menu fermé)
  setMenu(isMenuOpen());

  menuToggle?.addEventListener('click', () => {
    setMenu(!isMenuOpen());
  });

  // Fermeture au clic sur un lien
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => setMenu(false));
  });

  // Fermeture au clavier (Escape) + focus rendu au bouton
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMenuOpen()) {
      setMenu(false);
      menuToggle?.focus();
    }
  });

  // Menus déroulants du desktop (« Les étapes », « À propos »). Le survol ne
  // suffit pas : sans souris (tactile, clavier), le bouton ouvre et ferme la
  // liste. Un seul menu ouvert à la fois.
  const dropdowns = Array.from(document.querySelectorAll<HTMLElement>('[data-dropdown]')).map((root) => ({
    root,
    toggle: root.querySelector<HTMLButtonElement>('[data-dropdown-toggle]'),
    menu: root.querySelector<HTMLElement>('[data-dropdown-menu]'),
    chevron: root.querySelector<SVGElement>('[data-chevron]'),
    timer: undefined as number | undefined,
  }));
  type Dropdown = (typeof dropdowns)[number];

  const isOpen = (d: Dropdown) => d.toggle?.getAttribute('aria-expanded') === 'true';

  function setDropdown(d: Dropdown, open: boolean) {
    if (!d.menu || !d.toggle) return;
    window.clearTimeout(d.timer);
    if (open) dropdowns.forEach((other) => other !== d && isOpen(other) && setDropdown(other, false));
    d.menu.classList.toggle('hidden', !open);
    d.toggle.setAttribute('aria-expanded', String(open));
    d.chevron?.classList.toggle('rotate-180', open);
  }

  dropdowns.forEach((d) => {
    // À la souris, le survol a déjà ouvert la liste : le clic la laisse
    // ouverte au lieu de la refermer. Clavier (pointerType vide) et toucher
    // basculent.
    d.toggle?.addEventListener('click', (e) => {
      if ((e as PointerEvent).pointerType === 'mouse') setDropdown(d, true);
      else setDropdown(d, !isOpen(d));
    });
    // Survol à la souris uniquement : un toucher émet aussi pointerenter, qui
    // rouvrirait la liste juste avant que le clic ne la referme.
    d.root.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') setDropdown(d, true);
    });
    d.root.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse') return;
      d.timer = window.setTimeout(() => setDropdown(d, false), 150);
    });
    // Focus sorti du menu (Tab) : fermeture.
    d.root.addEventListener('focusout', (e) => {
      if (!d.root.contains(e.relatedTarget as Node | null)) setDropdown(d, false);
    });
    // Lien d'ancre vers la page courante : pas de rechargement, on referme.
    d.menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setDropdown(d, false)));
  });

  // Clic ailleurs ou Échap : fermeture, focus rendu au bouton avec Échap.
  document.addEventListener('click', (e) => {
    dropdowns.forEach((d) => {
      if (isOpen(d) && !d.root.contains(e.target as Node)) setDropdown(d, false);
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    dropdowns.forEach((d) => {
      if (isOpen(d)) {
        setDropdown(d, false);
        d.toggle?.focus();
      }
    });
  });
</script>
