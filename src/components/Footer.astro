---
import { getLang, localizePath } from '../i18n';
import { ui } from '../i18n/ui';
import { partnersByTier } from '../data/partners';
import PartnerLogo from './PartnerLogo.astro';

const lang = getLang(Astro.currentLocale);
const t = ui[lang].footer;
const goldLabel = ui[lang].pyramid.gold;
const gold = partnersByTier('gold');
const others = [...partnersByTier('organiser'), ...partnersByTier('partner')];
const p = (path: string) => localizePath(path, lang);
---

<footer class="border-t border-white/[0.06] py-12">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Bandeau partenaires, sur toutes les pages : le palier Gold en grand,
         organisateurs et partenaires en dessous (src/data/partners.ts). -->
    <div class="mb-10 pb-10 border-b border-white/[0.06] flex flex-col items-center gap-8">
      <div class="flex flex-col items-center gap-4">
        <span class="font-mono text-[11px] tracking-[0.18em] uppercase text-gold/80">{goldLabel}</span>
        <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6">
          {gold.map((p) => <PartnerLogo partner={p} size={p.size.band} pad="px-5 py-3" box="w-48 h-16 sm:w-56 sm:h-[68px]" />)}
        </div>
      </div>
      <div class="flex flex-col items-center gap-4">
        <span class="font-mono text-[11px] tracking-[0.18em] uppercase text-white/50">{t.partnersBand}</span>
        <div class="flex flex-wrap items-center justify-center gap-3">
          {others.map((p) => <PartnerLogo partner={p} size={p.size.band} pad="px-3 py-2" box="w-32 h-12 sm:w-32 sm:h-12" />)}
        </div>
      </div>
    </div>

    <!-- Ligne 1 : logo, dates, retour en haut -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 mb-8">
      <a href={p('/')} class="flex items-center gap-3">
        <img src="/assets/logo-cybertour-2026-blanc.webp" alt={t.logoAlt} width="395" height="256" class="h-12 sm:h-14 w-auto" />
      </a>

      <p class="text-white/50 text-sm font-mono text-center">
        {t.dates}
      </p>

      <a href={p('/#main-content')} class="text-white/50 hover:text-gold transition-colors text-sm font-mono">
        {t.backToTop}
      </a>
    </div>

    <!-- Ligne 2 : dossier partenaire et pages légales -->
    <div class="border-t border-white/[0.06] pt-6 mb-6 flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
        <a href="mailto:evenement@clusir-roi.org" class="text-gold/80 hover:text-gold transition-colors text-sm font-mono">
          evenement@clusir-roi.org
        </a>
        <span class="hidden sm:inline text-white/10" aria-hidden="true">|</span>
        <a href={`mailto:evenement@clusir-roi.org?subject=${encodeURIComponent(t.partnerDeckSubject)}`} class="text-white/50 hover:text-gold transition-colors text-sm font-mono">
          {t.partnerDeck}
        </a>
        <span class="hidden sm:inline text-white/10" aria-hidden="true">|</span>
        <a href={p('/mentions-legales')} class="text-white/50 hover:text-gold transition-colors text-sm font-mono">
          {t.legal}
        </a>
        <span class="hidden sm:inline text-white/10" aria-hidden="true">|</span>
        <a href={p('/confidentialite')} class="text-white/50 hover:text-gold transition-colors text-sm font-mono">
          {t.privacy}
        </a>
        <span class="hidden sm:inline text-white/10" aria-hidden="true">|</span>
        <a href={p('/cookies')} class="text-white/50 hover:text-gold transition-colors text-sm font-mono">
          {t.cookies}
        </a>
    </div>

    <!-- Bottom row: LinkedIn links with names -->
    <div class="border-t border-white/[0.06] pt-6 flex flex-col sm:flex-row items-center justify-center gap-6">
      <a href="https://www.linkedin.com/company/clusir-roi/" target="_blank" rel="noopener" class="flex items-center gap-2 text-white/50 hover:text-gold transition-colors">
        <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        <span class="text-xs font-mono">CLUSIR Réunion Océan Indien</span>
      </a>
      <span class="hidden sm:block text-white/10" aria-hidden="true">|</span>
      <a href="https://www.linkedin.com/company/cyber-reunion/" target="_blank" rel="noopener" class="flex items-center gap-2 text-white/50 hover:text-gold transition-colors">
        <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        <span class="text-xs font-mono">Cyber Reunion</span>
      </a>
    </div>
  </div>
</footer>
