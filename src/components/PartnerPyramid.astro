---
import { getLang } from '../i18n';
import { ui } from '../i18n/ui';

const t = ui[getLang(Astro.currentLocale)].pyramid;

/**
 * PartnerPyramid — pyramide des partenaires institutionnels de l'événement,
 * la plus étroite en haut (organisateur) et s'élargissant vers le bas.
 *
 * Les paliers de sponsoring payant ne figurent PAS ici : ils vivent dans la
 * section #sponsors, seule source de vérité tarifaire de la page. Le détail
 * des contreparties est réservé au dossier partenaire, hors site.
 */
---

<section class="relative py-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col items-center gap-12">

      <!-- Level 1 — Organisateur -->
      <div class="reveal flex flex-col items-center gap-6 max-w-2xl w-full">
        <span class="font-mono text-sm tracking-widest uppercase text-gold">
          {t.organiser}
        </span>
        <div class="flex items-center justify-center gap-6">
          <div class="partner-bubble px-8 py-4">
            <img
              src="/assets/logo-clusir.png"
              alt="CLUSIR Réunion Océan Indien"
              class="h-20 sm:h-24 w-auto object-contain"
              loading="lazy"
            />
          </div>
          <div class="partner-bubble px-8 py-4">
            <img
              src="/assets/logo-univ-reunion.png"
              alt="Université de La Réunion"
              class="h-20 sm:h-24 w-auto object-contain"
              loading="lazy"
            />
          </div>
        </div>
        <!-- Connecting line -->
        <div class="w-px h-8 bg-white/10"></div>
      </div>

      {/* Level 2 — Partenaires Gold. La charte proscrit le mot « sponsor »
          en public (art. 6.4) : le palier s'appelle Gold, la structure est
          un partenaire. */}
      <div class="reveal delay-1 flex flex-col items-center gap-6 max-w-2xl w-full">
        <span class="font-mono text-sm tracking-widest uppercase text-gold/80">
          {t.gold}
        </span>
        <div class="flex flex-wrap items-center justify-center gap-6">
          <div class="partner-bubble px-7 py-4">
            <img
              src="/assets/logo-orange-cyberdefense.png"
              alt="Orange Cyberdefense"
              class="h-9 sm:h-11 w-auto object-contain"
              loading="lazy"
            />
          </div>
          <div class="partner-bubble px-7 py-4">
            <img
              src="/assets/logo-sfr-business.png"
              alt="SFR Business"
              class="h-14 sm:h-[4.5rem] w-auto object-contain"
              loading="lazy"
            />
          </div>
          <div class="partner-bubble px-7 py-4">
            <img
              src="/assets/logo-youtell.png"
              alt="YOUTELL"
              class="h-11 sm:h-14 w-auto object-contain rounded-lg"
              loading="lazy"
            />
          </div>
        </div>
        <!-- Connecting line -->
        <div class="w-px h-8 bg-white/10"></div>
      </div>

      <!-- Level 3 — Partenaires -->
      <div class="reveal delay-2 flex flex-col items-center gap-6 max-w-2xl w-full">
        <span class="font-mono text-sm tracking-widest uppercase text-white/60">
          {t.partners}
        </span>
        <div class="flex flex-wrap items-center justify-center gap-6">
          <div class="partner-bubble px-6 py-3">
            <img
              src="/assets/logo-iut.png"
              alt="IUT de La Réunion"
              class="h-14 sm:h-16 w-auto object-contain"
              loading="lazy"
            />
          </div>
          <div class="partner-bubble px-6 py-3">
            <img
              src="/assets/logo-esiroi.jpg"
              alt="ESIROI — École d'Ingénieurs"
              class="h-14 sm:h-16 w-auto object-contain"
              loading="lazy"
            />
          </div>
          <div class="partner-bubble px-6 py-3">
            <img
              src="/assets/logo-cyber-reunion.jpg"
              alt="Cyber Réunion"
              class="h-14 sm:h-16 w-auto object-contain"
              loading="lazy"
            />
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
