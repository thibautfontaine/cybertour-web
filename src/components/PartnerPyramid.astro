---
/**
 * PartnerPyramid — pyramide des partenaires et des paliers de sponsoring,
 * la plus étroite en haut (organisateur) et s'élargissant vers le bas.
 *
 * Les paliers affichent l'inventaire réellement disponible. Aucun sponsor
 * n'est confirmé à ce jour : on montre les places ouvertes, jamais des logos
 * fictifs. Seul Platinium porte une limite annoncée (exclusivité, 1 seul
 * sponsor) ; les autres paliers n'ont pas de plafond publié, donc on n'en
 * invente pas.
 */

interface SponsorTier {
  name: string;
  price: string;
  availability: string;
  accent: string;
  accentBorder: string;
  accentBg: string;
  width: string;
  subject: string;
}

const tiers: SponsorTier[] = [
  {
    name: 'Platinium',
    price: '10 000 €',
    availability: '1 place — exclusivité',
    accent: 'text-purple-300',
    accentBorder: 'border-purple-400/40',
    accentBg: 'bg-purple-400/[0.06]',
    width: 'max-w-md',
    subject: 'Sponsoring Platinium — 10 000 €',
  },
  {
    name: 'Gold',
    price: '5 000 €',
    availability: 'Places ouvertes',
    accent: 'text-gold',
    accentBorder: 'border-gold/40',
    accentBg: 'bg-gold/[0.06]',
    width: 'max-w-xl',
    subject: 'Sponsoring Gold — 5 000 €',
  },
  {
    name: 'Silver',
    price: '3 000 €',
    availability: 'Places ouvertes',
    accent: 'text-gray-300',
    accentBorder: 'border-gray-400/40',
    accentBg: 'bg-gray-400/[0.06]',
    width: 'max-w-2xl',
    subject: 'Sponsoring Silver — 3 000 €',
  },
  {
    name: 'Bronze',
    price: '1 000 €',
    availability: 'Places ouvertes',
    accent: 'text-amber-500',
    accentBorder: 'border-amber-500/40',
    accentBg: 'bg-amber-500/[0.06]',
    width: 'max-w-3xl',
    subject: 'Sponsoring Bronze — 1 000 €',
  },
];

const contactMail = 'evenement@clusir-roi.org';
---

<section class="relative py-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col items-center gap-12">

      <!-- Level 1 — Organisateur -->
      <div class="reveal flex flex-col items-center gap-6 max-w-2xl w-full">
        <span class="font-mono text-sm tracking-widest uppercase text-gold">
          Organisateur
        </span>
        <div class="flex items-center justify-center gap-6">
          <div class="partner-bubble px-8 py-4">
            <img
              src="/assets/logo-clusir.png"
              alt="CLUSIR Réunion Océan Indien"
              class="h-20 sm:h-24 w-auto object-contain"
              loading="lazy"
            />
          </div>
          <div class="partner-bubble px-8 py-4">
            <img
              src="/assets/logo-univ-reunion.png"
              alt="Université de La Réunion"
              class="h-20 sm:h-24 w-auto object-contain"
              loading="lazy"
            />
          </div>
        </div>
        <!-- Connecting line -->
        <div class="w-px h-8 bg-white/10"></div>
      </div>

      <!-- Level 2 — Partenaires -->
      <div class="reveal delay-1 flex flex-col items-center gap-6 max-w-2xl w-full">
        <span class="font-mono text-sm tracking-widest uppercase text-white/60">
          Partenaires
        </span>
        <div class="flex flex-wrap items-center justify-center gap-6">
          <div class="partner-bubble px-6 py-3">
            <img
              src="/assets/logo-univ-reunion.png"
              alt="Université de La Réunion"
              class="h-14 sm:h-16 w-auto object-contain"
              loading="lazy"
            />
          </div>
          <div class="partner-bubble px-6 py-3">
            <img
              src="/assets/logo-iut.png"
              alt="IUT de La Réunion"
              class="h-14 sm:h-16 w-auto object-contain"
              loading="lazy"
            />
          </div>
          <div class="partner-bubble px-6 py-3">
            <img
              src="/assets/logo-esiroi.jpg"
              alt="ESIROI — École d'Ingénieurs"
              class="h-14 sm:h-16 w-auto object-contain"
              loading="lazy"
            />
          </div>
          <div class="partner-bubble px-6 py-3">
            <img
              src="/assets/logo-cyber-reunion.jpg"
              alt="Cyber Réunion"
              class="h-14 sm:h-16 w-auto object-contain"
              loading="lazy"
            />
          </div>
        </div>
        <!-- Connecting line -->
        <div class="w-px h-8 bg-white/10"></div>
      </div>

      <!-- Sponsor Tiers — places ouvertes, inventaire réel -->
      <div class="reveal delay-2 w-full flex flex-col items-center gap-6">
        <span class="font-mono text-sm tracking-widest uppercase text-white/60">
          Partenariats 2026 — places ouvertes
        </span>

        <ul class="w-full flex flex-col items-center gap-4">
          {tiers.map((tier) => (
            <li class={`w-full ${tier.width}`}>
              <a
                href={`mailto:${contactMail}?subject=${encodeURIComponent(tier.subject)}`}
                class={`group flex items-center justify-between gap-4 w-full ${tier.accentBg} ${tier.accentBorder} border border-dashed rounded-2xl px-6 py-4 transition-colors hover:border-solid`}
              >
                <span class="flex flex-col text-left">
                  <span class={`font-display font-bold text-lg ${tier.accent}`}>{tier.name}</span>
                  <span class="font-mono text-xs text-white/60 mt-0.5">{tier.availability}</span>
                </span>
                <span class="flex items-center gap-4 shrink-0">
                  <span class="font-mono font-bold text-base text-white">{tier.price}</span>
                  <span class={`font-mono text-xs uppercase tracking-wider ${tier.accent} opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity hidden sm:inline`}>
                    Réserver
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>

      </div>

    </div>
  </div>
</section>
