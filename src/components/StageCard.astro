---
import { ACCENT_PAINT, ACCENT_TEXT, type Stage } from "../data/stages";

interface Props {
  stage: Stage;
}

const { stage } = Astro.props;

/* Une étape non publiée (art. 8.8 — fiche annexe F non reçue) rend une carte
   inerte plutôt qu'un lien mort. Le composant racine change de balise. */
const Root = stage.published ? "a" : "div";
const rootProps = stage.published
  ? { href: stage.href, style: "touch-action: manipulation;" }
  : {};
---

<Root
  {...rootProps}
  class:list={[
    "group topic-card",
    "relative block overflow-hidden rounded-2xl border border-white/[0.08] transition-all duration-400",
    stage.published ? "hover:border-white/[0.15]" : "opacity-90",
  ]}
>
  <!-- Gradient accent top bar -->
  <div
    class="h-1.5 w-full"
    style={`background: linear-gradient(90deg, ${ACCENT_PAINT}, ${ACCENT_PAINT}60);`}
  ></div>

  <!-- Background glow -->
  <div
    class="absolute top-0 right-0 w-48 h-48 rounded-full blur-[80px] opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
    style={`background: ${ACCENT_PAINT};`}
  ></div>

  <div class="relative p-6 sm:p-8">
    <!-- Header row: number + direction + capacity -->
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-3">
        <span
          class="inline-flex items-center justify-center w-10 h-10 rounded-lg font-mono text-sm font-bold"
          style={`background: ${ACCENT_PAINT}15; color: ${ACCENT_TEXT}; border: 1px solid ${ACCENT_PAINT}30;`}
        >{stage.trackNumber}</span>
        <div>
          <h3 class="font-display font-bold text-xl sm:text-2xl text-white leading-tight">
            {stage.direction}
          </h3>
          <p class="font-mono text-xs tracking-wider uppercase font-bold" style={`color: ${ACCENT_TEXT};`}>
            {stage.dateShort}
          </p>
        </div>
      </div>
      {stage.capacity !== null && (
        <span
          class="inline-flex items-center justify-center px-3 py-1 rounded-full text-xs font-mono font-bold"
          style={`background: ${ACCENT_PAINT}18; color: ${ACCENT_TEXT}; border: 1px solid ${ACCENT_PAINT}25;`}
        >
          {stage.capacity} places
        </span>
      )}
    </div>

    <!-- Theme -->
    <p class="text-white/80 text-base font-semibold mb-2">{stage.theme}</p>

    <!-- Lieu -->
    <div class="flex items-center gap-2 text-white/55 text-sm mb-5">
      <svg class="w-4 h-4 shrink-0" style={`color: ${ACCENT_PAINT}80;`} fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
        <circle cx="12" cy="10" r="3"/>
      </svg>
      <span>{stage.lieu}</span>
    </div>

    <!-- Separator -->
    <div class="h-px w-full mb-5" style={`background: linear-gradient(90deg, ${ACCENT_PAINT}30, transparent);`}></div>

    <!-- Tags -->
    <div class="flex flex-wrap gap-2 mb-6">
      {stage.highlights.map((tag) => (
        <span
          class="px-2.5 py-1 rounded-md text-xs font-mono"
          style={`background: ${ACCENT_PAINT}10; color: ${ACCENT_TEXT}CC;`}
        >
          {tag}
        </span>
      ))}
    </div>

    <!-- Accueillie par — art. 7.3 de la charte : « une étape du CyberTour
         organisée par [structure hôte] ». Champ uniforme sur les six étapes,
         CLUSIR compris : la distinction est factuelle, jamais hiérarchique. -->
    <div class="pt-5 border-t border-white/[0.08]">
      <p class="font-mono text-[10px] tracking-[0.19em] uppercase text-white/40">
        Accueillie par
      </p>
      <p class="font-display font-semibold text-white/90 mt-1">{stage.host}</p>
    </div>

    {stage.published ? (
      <div class="flex items-center justify-between mt-5">
        <span
          class="inline-flex items-center gap-2 text-sm font-bold tracking-wide uppercase group-hover:gap-3 transition-all duration-300"
          style={`color: ${ACCENT_TEXT}`}
        >
          Découvrir l'étape
          <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
        </span>
      </div>
    ) : (
      <p class="mt-5 font-mono text-xs uppercase tracking-wider text-white/40">
        Programme à venir
      </p>
    )}
  </div>
</Root>
