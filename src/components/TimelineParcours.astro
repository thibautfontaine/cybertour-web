---
import { getStages, ACCENT_PAINT, ACCENT_TEXT, CLUSIR } from "../data/stages";
import { getLang } from "../i18n";
import { ui } from "../i18n/ui";

const lang = getLang(Astro.currentLocale);
const stages = getStages(lang);
const t = ui[lang].stage;
const tl = ui[lang].timeline;

/* La frise possède le « quand » et nomme le lieu ; l'organisateur est sur la
   carte d'étape juste en dessous (retour de Vincent, 18/09/2026).

   Échelle calendaire, grammaire « Barcode Lollipop » (lieflat-charts L3) :
   un repère par jour, qu'il s'y passe quelque chose ou non, un point par
   étape. Les jours vides restent visibles : le trou du 24 au 26 et le 28
   sont des faits du calendrier, pas des blancs à tasser. Le Sud occupe deux
   jours, donc deux points : 6 lieux, 7 étapes. */
const DAY = 86_400_000;
const toDate = (iso: string) => new Date(`${iso}T00:00:00Z`);
const locale = lang === "fr" ? "fr-FR" : "en-GB";
const fmt = (iso: string, opts: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat(locale, { timeZone: "UTC", ...opts }).format(toDate(iso));

const points = stages
  .flatMap((stage) => stage.days.map((iso) => ({ iso, stage })))
  .sort((a, b) => a.iso.localeCompare(b.iso))
  .map((p, i) => ({
    ...p,
    n: String(i + 1).padStart(2, "0"),
    dateShort: fmt(p.iso, { weekday: "short", day: "numeric", month: "short" }),
    dateLong: fmt(p.iso, { weekday: "long", day: "numeric", month: "long" }),
  }));

const first = toDate(points[0].iso).getTime();
const colOf = (iso: string) => Math.round((toDate(iso).getTime() - first) / DAY) + 1;
const span = colOf(points[points.length - 1].iso);
const cols = `grid-template-columns: repeat(${span}, minmax(0, 1fr));`;

const calendar = Array.from({ length: span }, (_, i) => {
  const iso = new Date(first + i * DAY).toISOString().slice(0, 10);
  return {
    iso,
    weekday: fmt(iso, { weekday: "short" }).replace(".", ""),
    dayNum: toDate(iso).getUTCDate(),
    hasStage: points.some((p) => p.iso === iso),
  };
});

/* Deux groupes, un fait : qui porte l'étape. Même couleur pour les deux, la
   distinction reste factuelle, jamais hiérarchique (art. 7.3 de la charte). */
const groups = [
  points.filter((p) => p.stage.host === CLUSIR),
  points.filter((p) => p.stage.host !== CLUSIR),
]
  .filter((pts) => pts.length > 0)
  .map((pts, i) => ({
    pts,
    label: i === 0 ? tl.clusirGroup(pts.length) : tl.localGroup(pts.length),
    from: colOf(pts[0].iso),
    to: colOf(pts[pts.length - 1].iso),
  }));
---

<div class="max-w-6xl mx-auto">
  {/* Frise horizontale à partir de md. Règle, rail et groupes sont trois
      grilles alignées sur les mêmes colonnes (une par jour) ; seule la liste
      des étapes est lue par les lecteurs d'écran. */}
  <div class="hidden md:block">
    <div class="grid" style={cols} aria-hidden="true">
      {calendar.map((c) => (
        <div class="flex flex-col items-center">
          <span class:list={["font-mono text-[10px] tracking-[0.12em] uppercase", c.hasStage ? "text-white/55" : "text-white/25"]}>
            {c.weekday}
          </span>
          <span class:list={["font-display font-semibold text-base leading-none mt-1", c.hasStage ? "text-white" : "text-white/25"]}>
            {c.dayNum}
          </span>
          <span class:list={["block w-px h-4 mt-2", c.hasStage ? "bg-white/40" : "bg-white/15"]}></span>
        </div>
      ))}
    </div>

    <div class="relative">
      <div
        class="absolute top-[7px] h-px"
        aria-hidden="true"
        style={`left: calc(100% / ${span * 2}); right: calc(100% / ${span * 2}); background: rgba(255,255,255,.22);`}
      ></div>
      {/* Jours sans étape : un grain sur le rail, pour que le vide se lise. */}
      <div class="absolute inset-x-0 top-0 grid" style={cols} aria-hidden="true">
        {calendar.map((c) => (
          <span class="flex justify-center pt-[5px]">
            {!c.hasStage && <span class="block w-[5px] h-[5px] rounded-full bg-white/25"></span>}
          </span>
        ))}
      </div>

      <ol class="relative grid list-none m-0 p-0" style={cols} aria-label={tl.label}>
        {points.map((p) => (
          <li class="flex flex-col items-center text-center px-0.5" style={`grid-column: ${colOf(p.iso)}; grid-row: 1;`}>
            <span
              class="block w-[15px] h-[15px] rounded-full"
              style={`background: ${ACCENT_PAINT}; box-shadow: 0 0 0 3px #0f1a30, 0 0 14px ${ACCENT_PAINT}80;`}
              aria-hidden="true"
            ></span>
            <span class="sr-only">{p.dateLong} —</span>
            <span class="font-mono text-[11px] tracking-[0.16em] font-bold mt-3" style={`color: ${ACCENT_TEXT};`}>
              {p.n}
            </span>
            <span class="block font-display font-semibold text-sm text-white mt-0.5">
              {p.stage.direction}
            </span>
            {/* Colonnes d'un jour : « accueillie par » s'y cassait en deux
                lignes, sept fois. Le pictogramme dit « lieu » sans le mot, le
                libellé complet reste pour les lecteurs d'écran. */}
            <span class="flex flex-col items-center font-mono text-[11px] text-white/80 leading-snug mt-1.5">
              <svg class="w-3 h-3 mb-0.5" style={`color: ${ACCENT_PAINT}B0;`} fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <span class="sr-only">{t.hostedByLower}</span>
              {p.stage.venue}
            </span>
          </li>
        ))}
      </ol>
    </div>

    <div class="grid mt-6" style={cols}>
      {groups.map((g) => (
        <div class="px-3" style={`grid-column: ${g.from} / ${g.to + 1};`}>
          <div class="h-2 border-x border-b border-white/25" aria-hidden="true"></div>
          <p class="font-mono text-[10px] tracking-[0.16em] uppercase text-white/55 text-center mt-2">
            {g.label}
          </p>
        </div>
      ))}
    </div>
  </div>

  {/* Repli vertical sous md, groupé par porteur. La ligne reste hors de l'<ol>
      (un <ol> n'admet que des <li>). */}
  <div class="md:hidden space-y-8">
    {groups.map((g) => (
      <div>
        <p class="font-mono text-[10px] tracking-[0.16em] uppercase text-white/55 mb-4">{g.label}</p>
        <div class="relative pl-9">
          <div class="absolute left-[7px] top-2 bottom-2 w-px bg-white/15" aria-hidden="true"></div>
          <ol class="list-none m-0 p-0">
            {g.pts.map((p) => (
              <li class="relative pb-6 last:pb-0">
                <span
                  class="absolute -left-9 top-1 w-[15px] h-[15px] rounded-full"
                  style={`background: ${ACCENT_PAINT}; box-shadow: 0 0 0 3px #0f1a30;`}
                  aria-hidden="true"
                ></span>
                <span class="font-mono text-[11px] tracking-[0.1em] text-white/50">{p.dateShort}</span>
                <span class="block font-display font-semibold text-white mt-0.5">
                  <span class="font-mono text-[11px] tracking-[0.16em] mr-2" style={`color: ${ACCENT_TEXT};`}>
                    {p.n}
                  </span>
                  {p.stage.direction}
                </span>
                <span class="block font-mono text-[11px] text-white/40 mt-1">
                  {t.hostedByLower} <span class="text-white/75">{p.stage.venue}</span>
                </span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    ))}
  </div>
</div>
