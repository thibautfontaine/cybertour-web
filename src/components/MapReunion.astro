---
import { getStages, ACCENT_PAINT } from "../data/stages";
import { getLang } from "../i18n";
import { ui } from "../i18n/ui";

const lang = getLang(Astro.currentLocale);
const stages = getStages(lang);
const t = ui[lang].map;

/* La carte possède le « où » et rien d'autre. Elle a perdu son titre et son
   statut de pièce maîtresse au profit de la frise (décision D6) : elle est
   désormais un encart. Le jour où le tour sort de La Réunion (art. 15 de la
   charte), on retire ce composant sans toucher à la structure de la page.

   Positions en pourcentage de l'image, calculées depuis les coordonnées GPS
   des lieux (la silhouette remplit son image : longitude 55.216 à 55.837,
   latitude -20.871 à -21.389). Le cadre garde le ratio de l'image, sinon les
   pourcentages ne tombent plus sur l'île. Les deux étapes de Sainte-Clotilde
   sont volontairement écartées pour rester distinctes (décision D7). */
const positions: Record<string, { top: number; left: number }> = {
  nord:     { top: 7.2,  left: 42.5 },  // PTU, Sainte-Clotilde
  edn:      { top: 6.9,  left: 50 },    // Campus Roger Roland, Sainte-Clotilde
  expernet: { top: 14.8, left: 14 },    // Parc 2000, Le Port
  ouest:    { top: 27.5, left: 11 },    // Office de l'Eau Réunion, Saint-Paul
  sud:      { top: 88.5, left: 43.8 },  // IUT / ESIROI, Saint-Pierre
};
---

<div class="relative w-full max-w-[280px] mx-auto">
  <div class="relative aspect-[1600/1452]">
    <img
      src="/assets/reunion-silhouette.png"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-contain opacity-30"
      style="filter: drop-shadow(0 0 40px rgba(255, 222, 89, 0.2));"
    />
    {stages.map((stage) => {
      const pos = positions[stage.id];
      if (!pos) return null;
      return (
        <span
          class="absolute -translate-x-1/2 -translate-y-1/2 z-10"
          style={`top: ${pos.top}%; left: ${pos.left}%;`}
          data-stage={stage.id}
        >
          <span
            class="block w-[11px] h-[11px] rounded-full"
            style={`background: ${ACCENT_PAINT}; box-shadow: 0 0 0 3px color-mix(in srgb, var(--theme-surface) 92%, transparent), 0 0 14px ${ACCENT_PAINT};`}
          />
          <span class="sr-only">{stage.name} — {stage.commune}</span>
        </span>
      );
    })}
  </div>
  <p class="text-center font-mono text-[10px] tracking-[0.13em] uppercase text-ink/45 mt-3">
    {t.caption}
  </p>
</div>
